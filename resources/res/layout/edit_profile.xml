<?xml version="1.0" encoding="utf-8"?>
<com.duracodefactory.logiccircuitsimulatorpro.ui.EditProfileDialog xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/edit_profile_dlg"
    android:background="@drawable/rounded_bg_no_outline_recent"
    android:paddingBottom="8dp"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:paddingEnd="16dp">
    <LinearLayout
        android:orientation="horizontal"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="56dp">
        <FrameLayout
            android:id="@+id/back_arrow"
            android:padding="16dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:foreground="@drawable/ripple"
            android:layout_marginStart="8dp">
            <View
                android:layout_gravity="center_vertical"
                android:background="@drawable/ic_left_arrow_dark"
                android:layout_width="@dimen/toolbar_back_dimen"
                android:layout_height="@dimen/toolbar_back_dimen"/>
        </FrameLayout>
        <TextView
            android:textSize="16sp"
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/profile"
            android:fontFamily="sans-serif-medium"
            android:layout_marginStart="8dp"
            style="@style/MediumDarkText"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:paddingStart="16dp">
        <ScrollView
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:layout_weight="1">
            <LinearLayout
                android:orientation="vertical"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="0dp">
                <FrameLayout
                    android:layout_gravity="center_horizontal"
                    android:background="@drawable/rounded_outline_bg"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:layout_width="@dimen/profile_edit_img_size"
                    android:layout_height="@dimen/profile_edit_img_size"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp">
                    <FrameLayout
                        android:clipChildren="true"
                        android:clipToPadding="true"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">
                        <androidx.appcompat.widget.AppCompatImageView
                            android:id="@+id/change_avatar"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"/>
                    </FrameLayout>
                    <TextView
                        android:textStyle="bold"
                        android:textColor="@color/light_on_accent"
                        android:background="?attr/colorAccent"
                        android:padding="8dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/tap_to_change"
                        android:fontFamily="sans-serif-condensed"
                        android:textAlignment="center"
                        style="@style/NormalDarkText"/>
                </FrameLayout>
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/hint_layout"
                    android:layout_width="@dimen/profile_edit_img_size"
                    android:layout_height="match_parent"
                    android:layout_margin="16dp"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">
                    <com.google.android.material.textfield.TextInputEditText
                        android:textSize="14sp"
                        android:id="@+id/change_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/user_name"
                        android:maxLines="1"
                        android:inputType="text"/>
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>
        </ScrollView>
        <LinearLayout
            android:layout_gravity="end"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <Button
                android:id="@+id/cancel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cancel"
                style="@style/Widget.MaterialComponents.Button.TextButton.Dialog"/>
            <Button
                android:id="@+id/ok"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/save"
                style="@style/Widget.MaterialComponents.Button.TextButton.Dialog"/>
        </LinearLayout>
    </LinearLayout>
</com.duracodefactory.logiccircuitsimulatorpro.ui.EditProfileDialog>
