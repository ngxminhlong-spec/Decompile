<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@drawable/rounded_bg_selectable"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="4dp"
    android:layout_marginBottom="4dp"
    android:layout_marginStart="16dp">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <FrameLayout
            android:id="@+id/header"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:foreground="@drawable/rounded_bg_no_outline"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <ImageView
                    android:layout_gravity="start|center_vertical"
                    android:id="@+id/icon"
                    android:layout_width="28dp"
                    android:layout_height="28dp"/>
                <LinearLayout
                    android:layout_gravity="start|center_vertical"
                    android:orientation="vertical"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="16dp">
                    <TextView
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:ellipsize="end"
                        android:id="@+id/title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxLines="2"
                        android:fontFamily="sans-serif-condensed"
                        style="@style/NormalDarkText"/>
                    <TextView
                        android:textSize="12sp"
                        android:textColor="@color/dark_secondary_text"
                        android:ellipsize="end"
                        android:id="@+id/description"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:maxLines="2"
                        android:fontFamily="sans-serif-condensed"
                        style="@style/SmallDarkText"/>
                </LinearLayout>
                <FrameLayout
                    android:layout_gravity="end|center_vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp">
                    <ImageView
                        android:layout_gravity="end"
                        android:id="@+id/expand"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_down_arrow"/>
                    <ImageView
                        android:layout_gravity="end"
                        android:id="@+id/collapse"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_up_arrow"/>
                </FrameLayout>
            </LinearLayout>
        </FrameLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/container_container"
            android:paddingBottom="4dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <FrameLayout
                android:id="@+id/container"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"/>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
