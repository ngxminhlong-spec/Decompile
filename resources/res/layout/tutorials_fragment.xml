<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@color/recents_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/tutorials_container"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fadeScrollbars="false">
        <FrameLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </FrameLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/tutorials_recycler_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="horizontal"
            android:background="@color/recents_bg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:elevation="4dp">
            <FrameLayout
                android:layout_gravity="center_vertical"
                android:id="@+id/back_arrow"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="12dp"
                android:foreground="@drawable/ripple">
                <View
                    android:layout_gravity="center_vertical"
                    android:background="@drawable/ic_left_arrow_dark"
                    android:layout_width="@dimen/toolbar_back_dimen"
                    android:layout_height="@dimen/toolbar_back_dimen"/>
            </FrameLayout>
            <TextView
                android:textStyle="bold"
                android:layout_gravity="center_vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tutorials"
                style="@style/BigDarkText"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/tutorials_r_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.duracodefactory.logiccircuitsimulatorpro.ui.RecentsRecyclerView
                android:id="@+id/tutorials_recycler"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:clipToPadding="false"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.2"
                android:paddingEnd="12dp"/>
            <androidx.cardview.widget.CardView xmlns:app="http://schemas.android.com/apk/res-auto"
                android:id="@+id/tutorials_tutorial_container_scroll"
                android:visibility="gone"
                android:clipToPadding="false"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="4dp"
                android:foreground="@drawable/ripple"
                android:layout_weight="1.8"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="12dp"
                android:elevation="@dimen/projects_item_elevation"
                app:cardBackgroundColor="@color/recent_project"
                app:cardCornerRadius="4dp">
                <ScrollView
                    android:id="@+id/tutorial_scroller"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <FrameLayout
                        android:id="@+id/tutorials_tutorial_container"
                        android:padding="36dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>
                </ScrollView>
            </androidx.cardview.widget.CardView>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
