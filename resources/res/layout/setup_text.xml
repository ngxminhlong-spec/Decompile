<?xml version="1.0" encoding="utf-8"?>
<com.duracodefactory.logiccircuitsimulatorpro.ui.TextSetup xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:layout_gravity="center_horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/text_properties"
        style="@style/BigDarkText"/>
    <View
        android:background="@color/separator_light"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginRight="16dp"/>
    <TextView
        android:textColor="@color/dark_secondary_text"
        android:layout_gravity="start|center_vertical"
        android:id="@+id/text_size_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/tap_text_to_change"
        android:textAllCaps="true"
        android:fontFamily="sans-serif-medium"
        android:layout_marginStart="12dp"
        style="@style/NormalDarkText"/>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="75dp">
        <TextView
            android:textColor="?attr/colorAccent"
            android:ellipsize="marquee"
            android:layout_gravity="center"
            android:id="@+id/text_size_preview_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:fontFamily="sans-serif"
            android:textAlignment="center"
            style="@style/BigDarkText"/>
        <TextView
            android:textColor="@color/header_bg"
            android:ellipsize="marquee"
            android:layout_gravity="center"
            android:id="@+id/text_size_preview_text_outline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:shadowColor="@color/icons_dark"
            android:shadowDx="0"
            android:shadowDy="0"
            android:shadowRadius="2"
            android:fontFamily="sans-serif"
            android:textAlignment="center"
            style="@style/BigDarkText"/>
    </FrameLayout>
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/text_size"
        android:fontFamily="sans-serif-medium"
        android:layout_marginStart="12dp"
        style="@style/MediumDarkText"/>
    <LinearLayout
        android:orientation="vertical"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp">
        <LinearLayout
            android:orientation="vertical"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layoutDirection="ltr"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp">
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textStyle="italic|bold"
                    android:layout_gravity="bottom"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Aa"
                    android:layout_weight="1"
                    android:fontFamily="serif"
                    android:textAlignment="textStart"
                    style="@style/SmallDarkText"/>
                <TextView
                    android:textStyle="italic|bold"
                    android:layout_gravity="bottom"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Aa"
                    android:layout_weight="1"
                    android:fontFamily="serif"
                    android:textAlignment="center"
                    style="@style/MediumDarkText"/>
                <TextView
                    android:textSize="16sp"
                    android:textStyle="italic|bold"
                    android:layout_gravity="bottom"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Aa"
                    android:layout_weight="1"
                    android:fontFamily="serif"
                    android:textAlignment="viewEnd"
                    style="@style/BigDarkText"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="11dp"
                android:layout_marginEnd="11dp">
                <TextView
                    android:textStyle="italic|bold"
                    android:textColor="@color/dark_secondary_text"
                    android:layout_gravity="bottom"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="|"
                    android:fontFamily="serif"
                    android:textAlignment="center"
                    style="@style/VerySmallDarkText"/>
                <TextView
                    android:textSize="5dp"
                    android:textStyle="italic|bold"
                    android:textColor="@color/dark_secondary_text"
                    android:layout_gravity="bottom"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="|"
                    android:layout_weight="1"
                    android:fontFamily="serif"
                    android:textAlignment="textEnd"
                    style="@style/VerySmallDarkText"/>
                <TextView
                    android:textStyle="italic|bold"
                    android:textColor="@color/dark_secondary_text"
                    android:layout_gravity="bottom"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="|"
                    android:layout_weight="2"
                    android:fontFamily="serif"
                    android:textAlignment="center"
                    style="@style/VerySmallDarkText"/>
                <TextView
                    android:textSize="5dp"
                    android:textStyle="italic|bold"
                    android:textColor="@color/dark_secondary_text"
                    android:layout_gravity="bottom"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="|"
                    android:layout_weight="1"
                    android:fontFamily="serif"
                    android:textAlignment="textStart"
                    style="@style/VerySmallDarkText"/>
                <TextView
                    android:textStyle="italic|bold"
                    android:textColor="@color/dark_secondary_text"
                    android:layout_gravity="bottom"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="|"
                    android:fontFamily="serif"
                    android:textAlignment="center"
                    style="@style/VerySmallDarkText"/>
            </LinearLayout>
            <com.duracodefactory.logiccircuitsimulatorpro.ui.Slider
                android:id="@+id/text_size_slider"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                app:positionsCount="5">
                <View
                    android:layout_gravity="center"
                    android:background="@drawable/dlg_button_bg"
                    android:layout_width="match_parent"
                    android:layout_height="8dp"/>
                <View
                    android:id="@+id/handle"
                    android:background="@drawable/slider_handle"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:elevation="2dp"/>
            </com.duracodefactory.logiccircuitsimulatorpro.ui.Slider>
        </LinearLayout>
        <LinearLayout
            android:layout_gravity="start|center_vertical"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginStart="12dp">
            <TextView
                android:layout_gravity="center_vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/only_outline"
                android:fontFamily="sans-serif-medium"
                android:layout_marginEnd="4dp"
                style="@style/MediumDarkText"/>
            <Switch
                android:layout_gravity="end"
                android:id="@+id/text_size_outline_switch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>
    </LinearLayout>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp">
        <Button
            android:layout_gravity="center"
            android:id="@+id/text_size_submit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/apply"/>
    </FrameLayout>
    <TextView
        android:paddingBottom="24dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/text_element_learn_main"
        style="@style/NormalDarkText"/>
</com.duracodefactory.logiccircuitsimulatorpro.ui.TextSetup>
