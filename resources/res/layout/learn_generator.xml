<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:layout_gravity="center_horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/learn_genrator_desc"
        style="@style/BigDarkText"/>
    <View
        android:background="@color/separator_light"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginRight="16dp"/>
    <ImageView
        android:layout_gravity="center_horizontal"
        android:layout_width="@dimen/learn_element_size"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:src="@drawable/ic_learn_generator"
        android:adjustViewBounds="true"/>
    <LinearLayout
        android:layout_gravity="center"
        android:orientation="vertical"
        android:id="@+id/generator_setup_container"
        android:visibility="gone"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp">
        <include
            android:id="@+id/generator_num_picker"
            layout="@layout/num_picker_custom"/>
        <Button
            android:layout_gravity="center_horizontal"
            android:id="@+id/settings_generator_setup_submit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/apply"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>
    </LinearLayout>
    <TextView
        android:layout_gravity="center_horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/learn_generator_main_text"
        style="@style/NormalDarkText"/>
    <View
        android:background="@color/separator_light"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginRight="16dp"/>
    <FrameLayout
        android:layout_gravity="center_horizontal"
        android:background="@drawable/learn_scheme_bg"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp">
        <ImageView
            android:layout_width="@dimen/learn_scheme_size"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            android:src="@drawable/ic_generator_schemes"
            android:adjustViewBounds="true"/>
    </FrameLayout>
</LinearLayout>
