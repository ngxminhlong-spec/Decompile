<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.coordinatorlayout.widget.CoordinatorLayout
            android:background="@color/header_bg"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:orientation="vertical"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <LinearLayout
                    android:orientation="vertical"
                    android:background="@color/header_bg"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <LinearLayout
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/header_toolbar_height"
                        android:paddingStart="12dp">
                        <ImageView
                            android:layout_gravity="start|center_vertical"
                            android:id="@+id/recents_logo_img"
                            android:paddingTop="20dp"
                            android:paddingBottom="20dp"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:src="@drawable/ic_logo"
                            android:scaleType="fitStart"
                            android:layout_weight="1"/>
                        <LinearLayout
                            android:layout_gravity="start|center_vertical"
                            android:orientation="horizontal"
                            android:clipChildren="false"
                            android:clipToPadding="false"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content">
                            <FrameLayout
                                android:id="@+id/settings_wheel"
                                android:padding="12dp"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:foreground="@drawable/ripple">
                                <View
                                    android:background="@drawable/ic_wheel"
                                    android:layout_width="@dimen/medium_icon_size"
                                    android:layout_height="@dimen/medium_icon_size"/>
                            </FrameLayout>
                        </LinearLayout>
                    </LinearLayout>
                    <View
                        android:background="@color/separator_light"
                        android:layout_width="match_parent"
                        android:layout_height="2dp"/>
                </LinearLayout>
                <FrameLayout
                    android:id="@+id/buy_banner"
                    android:background="?attr/colorAccent"
                    android:visibility="visible"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="24dp"
                    android:paddingEnd="24dp"
                    android:elevation="2dp">
                    <TextView
                        android:textSize="12dp"
                        android:textStyle="bold"
                        android:textColor="@color/light_on_accent"
                        android:layout_gravity="start|center_vertical"
                        android:id="@+id/buy_banner_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/unlock_full_version"
                        android:fontFamily="sans-serif-condensed-light"/>
                    <View
                        android:layout_gravity="end"
                        android:background="@drawable/ic_info_banner"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="8dp"/>
                </FrameLayout>
                <FrameLayout
                    android:id="@+id/shared_card_container_container"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp">
                    <include layout="@layout/share_card"/>
                </FrameLayout>
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1">
                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">
                        <FrameLayout
                            android:orientation="vertical"
                            android:id="@+id/recents_new_container"
                            android:visibility="gone"
                            android:clipChildren="false"
                            android:clipToPadding="false"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:paddingStart="@dimen/recents_side_padding"
                            android:paddingEnd="@dimen/recents_side_padding">
                            <com.duracodefactory.logiccircuitsimulatorpro.ui.RecentsRecyclerView
                                android:id="@+id/projects_recycler"
                                android:paddingTop="48dp"
                                android:paddingBottom="72dp"
                                android:clipToPadding="false"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:paddingStart="16dp"
                                android:paddingEnd="16dp"/>
                            <LinearLayout
                                android:orientation="vertical"
                                android:id="@+id/recent_recent_text"
                                android:clipChildren="false"
                                android:clipToPadding="false"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content">
                                <FrameLayout
                                    android:id="@+id/electrobox_container"
                                    android:clipChildren="false"
                                    android:clipToPadding="false"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:paddingStart="16dp"
                                    android:paddingEnd="16dp">
                                    <include layout="@layout/electrobox_card1"/>
                                </FrameLayout>
                                <LinearLayout
                                    android:orientation="horizontal"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="24dp">
                                    <ImageView
                                        android:layout_gravity="center_vertical"
                                        android:layout_width="18dp"
                                        android:layout_height="18dp"
                                        android:src="@drawable/ic_recents"
                                        android:scaleType="fitXY"/>
                                    <TextView
                                        android:textSize="12dp"
                                        android:textStyle="bold"
                                        android:textColor="@color/dark_text"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="16dp"
                                        android:layout_marginBottom="16dp"
                                        android:text="@string/recent_projects"
                                        android:fontFamily="sans-serif"
                                        android:layout_marginStart="8dp"/>
                                </LinearLayout>
                            </LinearLayout>
                        </FrameLayout>
                        <LinearLayout
                            android:orientation="horizontal"
                            android:id="@+id/tutorials_container"
                            android:visibility="gone"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent">
                            <com.duracodefactory.logiccircuitsimulatorpro.ui.RecentsRecyclerView
                                android:id="@+id/tutorials_recycler"
                                android:paddingTop="12dp"
                                android:paddingBottom="12dp"
                                android:clipToPadding="false"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1.2"/>
                            <FrameLayout
                                android:id="@+id/tutorials_tutorial_container_scroll"
                                android:background="@drawable/rounded_outline_bg"
                                android:visibility="gone"
                                android:clipToPadding="false"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_marginTop="16dp"
                                android:layout_marginBottom="16dp"
                                android:layout_weight="1.8"
                                android:layout_marginEnd="16dp">
                                <FrameLayout
                                    android:id="@+id/tutorial_scroller"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent">
                                    <FrameLayout
                                        android:id="@+id/tutorials_tutorial_container"
                                        android:paddingTop="2dp"
                                        android:paddingBottom="2dp"
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent"
                                        android:paddingStart="2dp"
                                        android:paddingEnd="2dp"/>
                                </FrameLayout>
                            </FrameLayout>
                        </LinearLayout>
                        <LinearLayout
                            android:orientation="horizontal"
                            android:id="@+id/learns_container"
                            android:visibility="gone"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent">
                            <com.duracodefactory.logiccircuitsimulatorpro.ui.RecentsRecyclerView
                                android:id="@+id/learning_recycler"
                                android:paddingTop="12dp"
                                android:paddingBottom="12dp"
                                android:clipToPadding="false"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:paddingEnd="16dp"/>
                            <FrameLayout
                                android:id="@+id/learn_container_scroll"
                                android:background="@drawable/rounded_outline_bg"
                                android:visibility="gone"
                                android:clipToPadding="false"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="16dp"
                                android:layout_marginBottom="16dp"
                                android:layout_weight="2"
                                android:layout_marginEnd="16dp">
                                <ScrollView
                                    android:id="@+id/learn_scroller"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content">
                                    <FrameLayout
                                        android:id="@+id/learn_container"
                                        android:padding="36dp"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content">
                                        <include layout="@layout/learn_and"/>
                                    </FrameLayout>
                                </ScrollView>
                            </FrameLayout>
                        </LinearLayout>
                        <LinearLayout
                            android:orientation="horizontal"
                            android:id="@+id/shared_container"
                            android:visibility="gone"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent">
                            <androidx.coordinatorlayout.widget.CoordinatorLayout
                                android:id="@+id/shared_fab_container"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1">
                                <LinearLayout
                                    android:orientation="vertical"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent">
                                    <FrameLayout
                                        android:id="@+id/shared_search_container"
                                        android:background="@drawable/search_bg"
                                        android:layout_width="match_parent"
                                        android:layout_height="40dp"
                                        android:layout_marginTop="16dp"
                                        android:layout_marginBottom="12dp"
                                        android:layout_marginStart="12dp"
                                        android:layout_marginEnd="12dp">
                                        <ImageView
                                            android:layout_gravity="start|center_vertical"
                                            android:layout_width="16dp"
                                            android:layout_height="16dp"
                                            android:src="@drawable/ic_search_icon"
                                            android:layout_marginStart="24dp"/>
                                        <EditText
                                            android:textSize="14sp"
                                            android:layout_gravity="start|center_vertical"
                                            android:id="@+id/search_edit"
                                            android:background="@null"
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:hint="@string/search_ics_here"
                                            android:inputType="textNoSuggestions"
                                            android:textAlignment="viewStart"
                                            android:layout_marginStart="54dp"
                                            android:layout_marginEnd="24dp"/>
                                        <ProgressBar
                                            android:layout_gravity="end|center_vertical"
                                            android:id="@+id/shared_search_progress"
                                            android:layout_width="20dp"
                                            android:layout_height="20dp"
                                            android:layout_marginEnd="24dp"
                                            android:indeterminateTint="?attr/colorAccent"/>
                                    </FrameLayout>
                                    <FrameLayout
                                        android:id="@+id/shared_message_container"
                                        android:background="@drawable/rounded_no_outline_bg_red"
                                        android:paddingTop="8dp"
                                        android:paddingBottom="8dp"
                                        android:visibility="gone"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_marginBottom="8dp"
                                        android:paddingStart="16dp"
                                        android:paddingEnd="16dp"
                                        android:layout_marginStart="16dp"
                                        android:layout_marginEnd="16dp">
                                        <TextView
                                            android:textColor="@color/light_on_accent"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:text="@string/share_info_message"
                                            android:fontFamily="sans-serif-medium"
                                            style="@style/SmallDarkText"/>
                                        <FrameLayout
                                            android:layout_gravity="end|center_vertical"
                                            android:id="@+id/shared_close_message"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:paddingEnd="4dp">
                                            <ImageView
                                                android:layout_width="12dp"
                                                android:layout_height="12dp"
                                                android:src="@drawable/ic_close_shared"/>
                                        </FrameLayout>
                                    </FrameLayout>
                                    <LinearLayout
                                        android:orientation="vertical"
                                        android:id="@+id/empty_search_results_text"
                                        android:visibility="gone"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="16dp">
                                        <ImageView
                                            android:layout_gravity="center_horizontal"
                                            android:layout_width="64dp"
                                            android:layout_height="64dp"
                                            android:src="@drawable/ic_empty_search_icon"/>
                                        <TextView
                                            android:layout_gravity="center_horizontal"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:layout_marginTop="16dp"
                                            android:text="@string/search_empty"
                                            android:fontFamily="sans-serif-medium"
                                            style="@style/NormalDarkText"/>
                                    </LinearLayout>
                                    <com.duracodefactory.logiccircuitsimulatorpro.ui.RecentsRecyclerView
                                        android:id="@+id/shared_recycler"
                                        android:paddingTop="4dp"
                                        android:paddingBottom="80dp"
                                        android:scrollbars="vertical"
                                        android:clipToPadding="false"
                                        android:layout_width="match_parent"
                                        android:layout_height="0dp"
                                        android:layout_weight="1"
                                        android:overScrollMode="never"
                                        android:paddingStart="16dp"
                                        android:paddingEnd="16dp"/>
                                </LinearLayout>
                                <com.google.android.material.floatingactionbutton.FloatingActionButton
                                    android:layout_gravity="end|bottom"
                                    android:id="@+id/share_fab"
                                    android:layout_width="@dimen/fab_size"
                                    android:layout_height="@dimen/fab_size"
                                    android:layout_marginBottom="16dp"
                                    android:src="@drawable/ic_upload_project_icon_fab"
                                    android:layout_marginEnd="@dimen/fab_margin"
                                    android:elevation="@dimen/fab_elevation"
                                    app:backgroundTint="?attr/colorAccent"
                                    app:tint="@color/recents_bg"/>
                                <FrameLayout
                                    android:id="@+id/explore_on_phone_container"
                                    android:background="@color/dim"
                                    android:focusable="true"
                                    android:visibility="gone"
                                    android:clickable="true"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:elevation="12dp"/>
                            </androidx.coordinatorlayout.widget.CoordinatorLayout>
                            <FrameLayout
                                android:id="@+id/shared_explore"
                                android:background="@drawable/rounded_outline_bg"
                                android:padding="4dp"
                                android:visibility="gone"
                                android:clipToPadding="false"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="16dp"
                                android:layout_marginBottom="16dp"
                                android:layout_weight="2"
                                android:layout_marginEnd="16dp"/>
                        </LinearLayout>
                    </FrameLayout>
                    <FrameLayout
                        android:layout_gravity="center"
                        android:id="@+id/recent_loading_container"
                        android:background="@drawable/recents_loading_bg"
                        android:padding="12dp"
                        android:visibility="gone"
                        android:layout_width="@dimen/recent_projects_loading_size"
                        android:layout_height="@dimen/recent_projects_loading_size">
                        <LinearLayout
                            android:orientation="vertical"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent">
                            <ProgressBar
                                android:layout_width="match_parent"
                                android:layout_height="0dp"
                                android:layout_weight="1"
                                android:indeterminateTint="@color/light"/>
                            <TextView
                                android:textStyle="bold"
                                android:textColor="@color/light_on_accent"
                                android:ellipsize="marquee"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="@string/loading"
                                android:singleLine="true"
                                android:textAlignment="center"
                                style="@style/MediumLightText"/>
                        </LinearLayout>
                    </FrameLayout>
                    <FrameLayout
                        android:layout_gravity="center"
                        android:id="@+id/empty_recents"
                        android:paddingBottom="50dp"
                        android:visibility="gone"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">
                        <LinearLayout
                            android:orientation="vertical"
                            android:clipChildren="false"
                            android:clipToPadding="false"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/you_don_t_have_any_projects"
                                style="@style/MediumDarkText"/>
                            <FrameLayout
                                android:layout_gravity="center_horizontal"
                                android:id="@+id/empty_projects_create"
                                android:background="@drawable/button_accent_bg"
                                android:paddingTop="12dp"
                                android:paddingBottom="12dp"
                                android:clipChildren="false"
                                android:clipToPadding="false"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                android:paddingStart="36dp"
                                android:paddingEnd="36dp"
                                android:elevation="8dp">
                                <TextView
                                    android:textColor="@color/light_on_accent"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/tap_to_create"
                                    android:textAllCaps="true"
                                    style="@style/SmallLightText"/>
                            </FrameLayout>
                        </LinearLayout>
                    </FrameLayout>
                </FrameLayout>
                <View
                    android:background="@color/separator_light"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"/>
                <include
                    android:id="@+id/recents_bottom_navigation"
                    layout="@layout/bottom_navigation"/>
            </LinearLayout>
            <FrameLayout
                android:layout_gravity="end|bottom"
                android:id="@+id/fab"
                android:background="@drawable/fab_button"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_width="@dimen/fab_size"
                android:layout_height="@dimen/fab_size"
                android:layout_marginBottom="@dimen/fab_bottom_margin"
                android:layout_marginEnd="@dimen/fab_margin"
                android:elevation="@dimen/fab_elevation">
                <FrameLayout
                    android:layout_gravity="center"
                    android:background="?attr/colorAccent"
                    android:padding="@dimen/fab_image_padding"
                    android:layout_width="@dimen/fab_inner_rect"
                    android:layout_height="@dimen/fab_inner_rect"
                    android:foreground="@drawable/ripple_light">
                    <View
                        android:layout_gravity="center"
                        android:background="@drawable/ic_projects_recents_fab"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"/>
                </FrameLayout>
            </FrameLayout>
            <FrameLayout
                android:id="@+id/share_dialog_container"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <include layout="@layout/upload_container_container"/>
            </FrameLayout>
        </androidx.coordinatorlayout.widget.CoordinatorLayout>
        <FrameLayout
            android:id="@+id/profile_info_container"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:elevation="@dimen/dlg_elevation">
            <View
                android:id="@+id/profile_edit_dim"
                android:background="@color/dim"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
            <FrameLayout
                android:layout_gravity="center"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <include
                        android:layout_gravity="center"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        layout="@layout/edit_profile"/>
                </FrameLayout>
            </FrameLayout>
        </FrameLayout>
    </androidx.coordinatorlayout.widget.CoordinatorLayout>
    <com.duracodefactory.logiccircuitsimulatorpro.ui.NavigationViewFit
        android:layout_gravity="start"
        android:background="@color/drawer_bg"
        android:layout_width="wrap_content"
        android:layout_height="match_parent">
        <include layout="@layout/main_navigation"/>
    </com.duracodefactory.logiccircuitsimulatorpro.ui.NavigationViewFit>
</androidx.drawerlayout.widget.DrawerLayout>
