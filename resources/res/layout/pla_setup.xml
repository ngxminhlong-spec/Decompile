<?xml version="1.0" encoding="utf-8"?>
<com.duracodefactory.logiccircuitsimulatorpro.ui.PLADialog xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:layout_gravity="center_horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/programmable_nlogic_array"
        android:textAlignment="center"
        style="@style/BigDarkText"/>
    <View
        android:background="@color/separator_light"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginRight="16dp"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/pla_interaction_container"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp">
        <LinearLayout
            android:layout_gravity="center_horizontal"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <FrameLayout
                android:id="@+id/and_array_button"
                android:background="@drawable/pla_container_selector"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:layout_width="80dp"
                android:layout_height="wrap_content">
                <TextView
                    android:textStyle="bold"
                    android:layout_gravity="center"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="AND Array"
                    android:fontFamily="sans-serif-condensed"
                    style="@style/NormalDarkText"/>
            </FrameLayout>
            <FrameLayout
                android:id="@+id/or_array_button"
                android:background="@drawable/pla_container_selector"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:layout_width="80dp"
                android:layout_height="wrap_content">
                <TextView
                    android:textStyle="bold"
                    android:layout_gravity="center"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="OR Array"
                    android:fontFamily="sans-serif-condensed"
                    style="@style/NormalDarkText"/>
            </FrameLayout>
            <FrameLayout
                android:id="@+id/info_array_button"
                android:background="@drawable/pla_container_selector"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:layout_width="80dp"
                android:layout_height="wrap_content">
                <TextView
                    android:textStyle="bold"
                    android:layout_gravity="center"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Info"
                    android:fontFamily="sans-serif-condensed"
                    style="@style/NormalDarkText"/>
            </FrameLayout>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/pla_dots_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp">
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.duracodefactory.logiccircuitsimulatorpro.ui.ProgrammableArrayView
                    android:id="@+id/andDotsView"
                    android:layout_width="match_parent"
                    android:layout_height="250dp"/>
                <com.duracodefactory.logiccircuitsimulatorpro.ui.ProgrammableArrayView
                    android:id="@+id/orDotsView"
                    android:layout_width="match_parent"
                    android:layout_height="250dp"/>
                <TextView
                    android:layout_gravity="center"
                    android:id="@+id/pla_setup_fixed_array"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/fixed_array"
                    android:textAllCaps="true"
                    android:textAlignment="center"
                    style="@style/VeryBigDarkText"/>
            </FrameLayout>
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="4dp">
                <Button
                    android:layout_gravity="center"
                    android:id="@+id/pla_setup_submit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/apply"/>
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/pla_info_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:layout_gravity="center_horizontal"
            android:layout_width="@dimen/learn_element_size"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:src="@drawable/ic_progrmabble_pla"
            android:adjustViewBounds="true"/>
        <TextView
            android:layout_gravity="center_horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/pla_main"
            style="@style/NormalDarkText"/>
        <FrameLayout
            android:layout_gravity="center_horizontal"
            android:background="@drawable/learn_scheme_bg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp">
            <ImageView
                android:layout_width="@dimen/learn_scheme_size"
                android:layout_height="wrap_content"
                android:layout_margin="16dp"
                android:src="@drawable/ic_learn_pla"
                android:adjustViewBounds="true"/>
        </FrameLayout>
        <TextView
            android:layout_gravity="center_horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/pla_secondary"
            style="@style/NormalDarkText"/>
    </LinearLayout>
</com.duracodefactory.logiccircuitsimulatorpro.ui.PLADialog>
