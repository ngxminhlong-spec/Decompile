<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:foreground="@drawable/ripple">
    <FrameLayout
        android:id="@+id/background_select"
        android:background="@drawable/controls_selected_bg"
        android:layout_width="46dp"
        android:layout_height="52dp"/>
    <FrameLayout
        android:paddingTop="8dp"
        android:layout_width="46dp"
        android:layout_height="52dp"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <View
                android:id="@+id/icon"
                android:layout_width="28dp"
                android:layout_height="28dp"/>
            <TextView
                android:textStyle="bold"
                android:ellipsize="marquee"
                android:gravity="bottom"
                android:id="@+id/text"
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                android:singleLine="true"
                android:layout_weight="1"
                android:textAllCaps="true"
                android:fontFamily="sans-serif"
                style="@style/VerySmallDarkText"/>
        </LinearLayout>
    </FrameLayout>
    <FrameLayout
        android:layout_gravity="end"
        android:id="@+id/pro_label"
        android:background="@drawable/rounded_no_outline_bg_red_new"
        android:paddingTop="2dp"
        android:paddingBottom="2dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="2dp"
        android:paddingEnd="2dp"
        android:elevation="6dp"
        android:backgroundTint="@color/accent_3">
        <TextView
            android:textSize="8dp"
            android:textColor="@color/light_on_accent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PRO"
            android:includeFontPadding="false"/>
    </FrameLayout>
</FrameLayout>
