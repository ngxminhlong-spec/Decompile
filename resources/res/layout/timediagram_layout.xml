<?xml version="1.0" encoding="utf-8"?>
<com.duracodefactory.logiccircuitsimulatorpro.ui.TimeDiagramLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/timediagram_container"
    android:background="@color/dim"
    android:focusable="true"
    android:visibility="gone"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="@dimen/time_diagram_layout_side_margin"
    android:paddingEnd="@dimen/time_diagram_layout_side_margin"
    android:elevation="12dp">
    <LinearLayout
        android:orientation="vertical"
        android:background="@color/recents_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="horizontal"
            android:background="@color/recents_bg"
            android:paddingBottom="4dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:elevation="4dp">
            <FrameLayout
                android:layout_gravity="center_vertical"
                android:id="@+id/timediagram_layout_back_arrow"
                android:padding="16dp"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:foreground="@drawable/ripple">
                <View
                    android:layout_gravity="center_vertical"
                    android:background="@drawable/ic_left_arrow_dark"
                    android:layout_width="@dimen/toolbar_back_dimen"
                    android:layout_height="@dimen/toolbar_back_dimen"/>
            </FrameLayout>
            <TextView
                android:textSize="18sp"
                android:layout_gravity="center_vertical"
                android:id="@+id/timediagram_layout_time_diagram_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/timediagram_title"
                android:fontFamily="sans-serif-medium"
                android:layout_marginStart="16dp"
                style="@style/BigDarkText"/>
        </LinearLayout>
        <ScrollView
            android:id="@+id/timediagram_layout_scrollView"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textStyle="bold"
                    android:textColor="@color/dark_secondary_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/starting_timediagra_caution"
                    android:layout_marginStart="24dp"
                    android:layout_marginEnd="24dp"
                    style="@style/NormalDarkText"/>
                <LinearLayout
                    android:layout_gravity="start"
                    android:orientation="horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp">
                    <Button
                        android:layout_gravity="center"
                        android:id="@+id/timediagram_layout_new"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/start_recording"/>
                    <View
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"/>
                    <Button
                        android:layout_gravity="center_vertical"
                        android:id="@+id/io_timediagram_help_button"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/help"
                        android:layout_marginStart="12dp"
                        app:icon="@drawable/ic_help_io"
                        app:iconSize="16dp"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>
                </LinearLayout>
                <TextView
                    android:textStyle="bold"
                    android:textColor="@color/dark_secondary_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/timediagram_layout_explanations"
                    android:fontFamily="sans-serif-condensed"
                    android:layout_marginStart="24dp"
                    android:layout_marginEnd="24dp"
                    style="@style/NormalDarkText"/>
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:layoutDirection="ltr">
                    <TextView
                        android:textColor="@color/dark_text"
                        android:layout_gravity="center_vertical"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/length"
                        android:fontFamily="sans-serif-medium"
                        android:layout_marginStart="16dp"
                        style="@style/MediumDarkText"/>
                    <TextView
                        android:textStyle="bold"
                        android:layout_gravity="center_vertical"
                        android:id="@+id/timing_diagram_layout_length"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0s"
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="16dp"
                        style="@style/NormalDarkText"/>
                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="16dp">
                        <LinearLayout
                            android:layout_gravity="end"
                            android:orientation="horizontal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content">
                            <TextView
                                android:layout_gravity="center_vertical"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/show_pins_on_circuit"
                                android:fontFamily="sans-serif-medium"
                                android:layout_marginEnd="8dp"
                                style="@style/NormalDarkText"/>
                            <Switch
                                android:layout_gravity="center"
                                android:id="@+id/timediagram_layout_show_pins"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"/>
                        </LinearLayout>
                    </FrameLayout>
                </LinearLayout>
                <com.duracodefactory.logiccircuitsimulatorpro.ui.RecentsRecyclerView
                    android:id="@+id/timediagram_layout_entries_rv"
                    android:scrollbars="vertical"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fadeScrollbars="false"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"/>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp">
                    <Button
                        android:layout_gravity="center_vertical"
                        android:id="@+id/timediagram_layout_add_node"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/add_new_entry"
                        app:icon="@drawable/ic_node_holder_add"
                        app:iconSize="16dp"
                        style="@style/Widget.MaterialComponents.Button.UnelevatedButton"/>
                    <View
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"/>
                    <LinearLayout
                        android:layout_gravity="bottom"
                        android:orientation="vertical"
                        android:id="@+id/timediagram_layout_export_as_image"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp">
                        <View
                            android:layout_gravity="center_horizontal"
                            android:background="@drawable/ic_export_dark"
                            android:layout_width="20dp"
                            android:layout_height="20dp"/>
                        <TextView
                            android:textColor="@color/dark_secondary_text"
                            android:layout_gravity="center_horizontal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="@string/export"
                            android:fontFamily="sans-serif-condensed"
                            style="@style/NormalDarkText"/>
                    </LinearLayout>
                </LinearLayout>
                <TextView
                    android:textColor="@color/dark_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/timing_diagram"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginStart="16dp"
                    style="@style/MediumDarkText"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/timediagram_layout_time_view_container"
                    android:paddingBottom="24dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="24dp"
                    android:paddingStart="24dp"
                    android:paddingEnd="24dp"
                    android:layout_marginStart="24dp"
                    android:layout_marginEnd="24dp">
                    <com.duracodefactory.logiccircuitsimulatorpro.ui.TimeDiagramView
                        android:id="@+id/timediagram_layout_time_view"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="true"/>
                    <LinearLayout
                        android:layout_gravity="center_horizontal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp">
                        <Button
                            android:textSize="20sp"
                            android:id="@+id/timediagram_zoom_in"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="+"
                            style="@style/Widget.MaterialComponents.Button.UnelevatedButton"/>
                        <Button
                            android:textSize="20sp"
                            android:id="@+id/timediagram_zoom_out"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="-"
                            android:layout_marginStart="8dp"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</com.duracodefactory.logiccircuitsimulatorpro.ui.TimeDiagramLayout>
