<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="16dp">
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <FrameLayout
            android:layout_gravity="center_vertical"
            android:background="@drawable/avatar_shadow_accent"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:elevation="2dp">
            <TextView
                android:textSize="16dp"
                android:textColor="@color/light_on_accent"
                android:layout_gravity="center"
                android:id="@+id/new_tut_digit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1"
                android:fontFamily="sans-serif"
                android:textAlignment="center"/>
        </FrameLayout>
        <FrameLayout
            android:layout_gravity="center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp">
            <ImageView
                android:id="@+id/new_tut_image"
                android:layout_width="@dimen/tut_image_entry_size_w"
                android:layout_height="@dimen/tut_image_entry_size_h"/>
        </FrameLayout>
        <FrameLayout
            android:layout_gravity="center_vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp">
            <TextView
                android:textSize="12dp"
                android:id="@+id/new_tut_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-light"
                style="@style/NormalDarkText"/>
        </FrameLayout>
    </LinearLayout>
    <View
        android:id="@+id/new_tut_bottom_line"
        android:background="@color/separator_light"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="16dp"/>
</LinearLayout>
