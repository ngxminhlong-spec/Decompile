<?xml version="1.0" encoding="utf-8"?>
<com.duracodefactory.logiccircuitsimulatorpro.ui.InsertProjectLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:focusable="true"
    android:clickable="true"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <TextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/select_circuit_to_import"
            android:fontFamily="sans-serif-condensed"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            style="@style/MediumDarkText"/>
        <FrameLayout
            android:layout_gravity="center"
            android:id="@+id/insert_project_empty"
            android:background="@drawable/rounded_no_outline_bg_accent"
            android:padding="12dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp">
            <TextView
                android:textColor="@color/light_on_accent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/no_projects_to_import"
                android:textAlignment="center"
                style="@style/NormalDarkText"/>
        </FrameLayout>
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp">
            <LinearLayout
                android:layout_gravity="center"
                android:orientation="horizontal"
                android:background="@drawable/rounded_outline_bg_accent"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">
                <TextView
                    android:textColor="?attr/colorAccent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/io_setup_help"
                    android:fontFamily="sans-serif-condensed"
                    style="@style/MediumDarkText"/>
            </LinearLayout>
        </FrameLayout>
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">
            <Button
                android:layout_gravity="center"
                android:id="@+id/show_help"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/show_me"
                app:icon="@drawable/ic_help_io"
                app:iconSize="16dp"
                style="@style/Widget.MaterialComponents.Button.UnelevatedButton"/>
        </FrameLayout>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/projects_recycler"
            android:paddingBottom="24dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="24dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"/>
    </LinearLayout>
    <FrameLayout
        android:layout_gravity="center"
        android:id="@+id/insert_project_loading"
        android:background="@drawable/recents_loading_bg"
        android:padding="12dp"
        android:visibility="gone"
        android:layout_width="@dimen/recent_projects_loading_size"
        android:layout_height="@dimen/recent_projects_loading_size">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <ProgressBar
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:indeterminateTint="@color/light"/>
            <TextView
                android:textStyle="bold"
                android:textColor="@color/light_on_accent"
                android:ellipsize="marquee"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/loading"
                android:singleLine="true"
                android:textAlignment="center"
                style="@style/MediumLightText"/>
        </LinearLayout>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/io_node_help"
        android:background="@color/dim"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</com.duracodefactory.logiccircuitsimulatorpro.ui.InsertProjectLayout>
