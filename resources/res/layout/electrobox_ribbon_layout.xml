<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:foreground="@drawable/ripple"
    android:layout_marginStart="8dp">
    <FrameLayout
        android:id="@+id/background_select"
        android:background="@drawable/controls_selected_bg"
        android:layout_width="@dimen/controls_small_size_w"
        android:layout_height="@dimen/controls_small_size_h"
        android:elevation="4dp"/>
    <FrameLayout
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:layout_width="@dimen/controls_small_size_w"
        android:layout_height="@dimen/controls_small_size_h"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:elevation="5dp">
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <View
                android:id="@+id/icon"
                android:layout_width="@dimen/controls_icon_small_size"
                android:layout_height="@dimen/controls_icon_small_size"/>
            <TextView
                android:ellipsize="marquee"
                android:gravity="bottom"
                android:id="@+id/text"
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                android:layout_marginTop="6dp"
                android:singleLine="true"
                android:layout_weight="1"
                android:fontFamily="sans-serif"
                style="@style/VerySmallDarkText"/>
        </LinearLayout>
    </FrameLayout>
    <FrameLayout
        android:layout_gravity="end"
        android:background="@drawable/rounded_no_outline_bg_red_new"
        android:paddingTop="2dp"
        android:paddingBottom="2dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="2dp"
        android:paddingEnd="2dp"
        android:elevation="6dp">
        <TextView
            android:textSize="8dp"
            android:textColor="@color/light_on_accent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/new_t"
            android:includeFontPadding="false"/>
    </FrameLayout>
</FrameLayout>
