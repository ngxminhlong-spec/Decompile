<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="4dp"
    android:elevation="@dimen/projects_item_elevation">
    <FrameLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="8dp"
        android:layout_marginTop="8dp"
        android:layout_marginRight="8dp"
        android:layout_marginBottom="4dp">
        <TextView
            android:textStyle="bold"
            android:ellipsize="marquee"
            android:layout_gravity="start|center_vertical"
            android:id="@+id/timediagram_entry_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Entry"
            android:singleLine="true"
            android:maxLength="50"
            style="@style/NormalDarkText"/>
        <LinearLayout
            android:layout_gravity="end"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <FrameLayout
                android:id="@+id/timediagram_edit_entry_name"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="12dp"
                android:paddingEnd="12dp">
                <ImageView
                    android:layout_gravity="start"
                    android:background="@drawable/ic_edit_name"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"/>
            </FrameLayout>
            <FrameLayout
                android:id="@+id/timingdiagram_color_entry"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="12dp"
                android:paddingEnd="12dp">
                <View
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/timingdiagram_color_entry_color"
                    android:background="@drawable/timediagram_entry_color_bg"
                    android:layout_width="18dp"
                    android:layout_height="18dp"/>
            </FrameLayout>
            <FrameLayout
                android:layout_gravity="end"
                android:id="@+id/timingdiagram_delete_entry"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="12dp"
                android:paddingEnd="12dp">
                <View
                    android:background="@drawable/ic_delete_circle"
                    android:layout_width="18dp"
                    android:layout_height="18dp"/>
            </FrameLayout>
        </LinearLayout>
    </FrameLayout>
    <View
        android:layout_gravity="bottom|center_horizontal"
        android:background="@color/separator_light"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="4dp"/>
</FrameLayout>
