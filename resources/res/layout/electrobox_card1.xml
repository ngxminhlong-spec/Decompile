<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="12dp"
    app:cardBackgroundColor="#fff"
    app:cardCornerRadius="20dp"
    app:cardElevation="8dp">
    <LinearLayout
        android:orientation="horizontal"
        android:background="@drawable/electrobox_holder_gradient"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">
        <FrameLayout
            android:layout_gravity="center_vertical"
            android:background="@drawable/circle_bg_accent"
            android:padding="16dp"
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:elevation="4dp"
            android:backgroundTint="#ffc300">
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/electrobox_cable"
                android:scaleType="fitCenter"/>
        </FrameLayout>
        <LinearLayout
            android:orientation="vertical"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="16dp">
            <TextView
                android:textSize="20dp"
                android:textStyle="bold"
                android:textColor="@color/light_on_accent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ElectroBox"
                android:includeFontPadding="false"
                android:fontFamily="sans-serif-medium"
                style="@style/BigDarkText"/>
            <TextView
                android:textSize="14dp"
                android:textColor="@color/light_on_accent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/try_our_new_application"
                android:includeFontPadding="false"
                android:fontFamily="sans-serif-condensed"
                style="@style/MediumDarkText"/>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp">
                <FrameLayout
                    android:background="@drawable/popular_bg"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp"
                    android:visibility="visible"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp">
                    <TextView
                        android:textSize="10dp"
                        android:textStyle="normal"
                        android:textColor="#cc000000"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/popular"
                        android:textAllCaps="true"
                        android:fontFamily="sans-serif-medium"/>
                </FrameLayout>
                <FrameLayout
                    android:background="@drawable/popular_bg"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp"
                    android:visibility="visible"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:layout_marginStart="8dp">
                    <TextView
                        android:textSize="10dp"
                        android:textStyle="normal"
                        android:textColor="#cc000000"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/free"
                        android:textAllCaps="true"
                        android:fontFamily="sans-serif-medium"/>
                </FrameLayout>
            </LinearLayout>
            <LinearLayout
                android:layout_gravity="end"
                android:orientation="horizontal"
                android:background="@drawable/download_button_bg"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:elevation="4dp">
                <ImageView
                    android:layout_gravity="center_vertical"
                    android:layout_width="16dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_gp"/>
                <TextView
                    android:textSize="12dp"
                    android:textStyle="bold"
                    android:textColor="#333"
                    android:layout_gravity="center_vertical"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/start"
                    android:layout_weight="1"
                    android:textAllCaps="true"
                    android:layout_marginStart="8dp"
                    android:letterSpacing="0.1"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
    <FrameLayout
        android:layout_gravity="end"
        android:id="@+id/electrobox_close"
        android:padding="12dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="8dp">
        <View
            android:background="@drawable/ic_close"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:backgroundTint="@color/light_on_accent"/>
    </FrameLayout>
</androidx.cardview.widget.CardView>
