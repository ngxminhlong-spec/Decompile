<?xml version="1.0" encoding="utf-8"?>
<com.duracodefactory.logiccircuitsimulatorpro.ui.GoPremiumLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="#ffffff"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/all_container"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="vertical"
            android:background="#f8f8f8"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:elevation="8dp">
            <FrameLayout
                android:paddingTop="32dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <FrameLayout
                    android:id="@+id/pricing_back_arrow"
                    android:padding="14dp"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp">
                    <View
                        android:layout_gravity="center_vertical"
                        android:background="@drawable/ic_close_dark"
                        android:layout_width="12dp"
                        android:layout_height="12dp"/>
                </FrameLayout>
                <TextView
                    android:textSize="24sp"
                    android:textStyle="normal"
                    android:textColor="#000000"
                    android:layout_gravity="center"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/go_premium"
                    android:lineSpacingExtra="6sp"
                    android:fontFamily="sans-serif-light"/>
            </FrameLayout>
            <FrameLayout
                android:id="@+id/pricing_main_container"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/main_purchases"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:overScrollMode="never"/>
            </FrameLayout>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp">
                <Button
                    android:textColor="#000000"
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/purchase_button"
                    android:layout_width="200dp"
                    android:layout_height="wrap_content"
                    android:text="@string/continue_text"
                    android:backgroundTint="#ffca2d"/>
                <LinearLayout
                    android:layout_gravity="center_horizontal"
                    android:orientation="horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="16dp"
                    android:layout_marginStart="24dp"
                    android:layout_marginEnd="24dp">
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_pro_label"
                        android:tint="#a0a0a0"
                        android:layout_marginEnd="12dp"/>
                    <TextView
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="#44000000"
                        android:layout_gravity="center_vertical"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/pricing_explanation"
                        android:fontFamily="sans-serif"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
        <ScrollView
            android:layout_gravity="center_horizontal"
            android:scrollbars="none"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:overScrollMode="never">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:layout_gravity="center_horizontal"
                    android:orientation="horizontal"
                    android:id="@+id/billing_error_container"
                    android:background="@drawable/permissions_caution_bg"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:layout_marginStart="24dp"
                    android:layout_marginEnd="24dp">
                    <ImageView
                        android:layout_gravity="center_vertical"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_caution_buy"/>
                    <TextView
                        android:textStyle="bold"
                        android:textColor="@color/light_on_accent"
                        android:layout_gravity="start|center_vertical"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/your_last_payment_was_not_successful"
                        android:fontFamily="sans-serif-condensed"
                        android:textAlignment="viewStart"
                        android:layout_marginStart="16dp"
                        style="@style/NormalDarkText"/>
                </LinearLayout>
                <LinearLayout
                    android:layout_gravity="center_horizontal"
                    android:orientation="horizontal"
                    android:id="@+id/pending_error_container"
                    android:background="@drawable/permissions_caution_bg"
                    android:paddingTop="12dp"
                    android:paddingBottom="16dp"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:layout_marginStart="24dp"
                    android:layout_marginEnd="24dp">
                    <ImageView
                        android:layout_gravity="center_vertical"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_caution_buy"/>
                    <TextView
                        android:textStyle="bold"
                        android:textColor="@color/light_on_accent"
                        android:layout_gravity="start|center_vertical"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/your_payment_is_pending"
                        android:fontFamily="sans-serif-condensed"
                        android:textAlignment="viewStart"
                        android:layout_marginStart="16dp"
                        style="@style/NormalDarkText"/>
                </LinearLayout>
                <LinearLayout
                    android:layout_gravity="center_horizontal"
                    android:orientation="horizontal"
                    android:id="@+id/prices_error"
                    android:background="@drawable/rounded_outline_bg_accent"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp">
                    <TextView
                        android:textColor="?attr/colorAccent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/error_loading_prices"
                        style="@style/MediumDarkText"/>
                </LinearLayout>
                <LinearLayout
                    android:layout_gravity="center_horizontal"
                    android:orientation="horizontal"
                    android:id="@+id/why_buy_message_container"
                    android:background="@drawable/permissions_caution_bg"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:layout_marginStart="24dp"
                    android:layout_marginEnd="24dp">
                    <ImageView
                        android:layout_gravity="center_vertical"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_caution_buy"/>
                    <TextView
                        android:textStyle="bold"
                        android:textColor="@color/light_on_accent"
                        android:layout_gravity="start|center_vertical"
                        android:id="@+id/why_buy_message"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-condensed"
                        android:textAlignment="viewStart"
                        android:layout_marginStart="16dp"
                        style="@style/NormalDarkText"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:paddingTop="16dp"
                    android:paddingBottom="16dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="24dp"
                    android:paddingEnd="24dp">
                    <LinearLayout
                        android:orientation="horizontal"
                        android:paddingTop="@dimen/go_premium_paddings"
                        android:paddingBottom="@dimen/go_premium_paddings"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">
                        <ImageView
                            android:layout_gravity="center_vertical"
                            android:layout_width="@dimen/go_premium_icon_size"
                            android:layout_height="@dimen/go_premium_icon_size"
                            android:src="@drawable/ic_remove_ads"/>
                        <LinearLayout
                            android:layout_gravity="center_vertical"
                            android:orientation="vertical"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="24dp">
                            <TextView
                                android:textSize="@dimen/go_premium_items_text_size"
                                android:textColor="#403c3c"
                                android:layout_gravity="start|center_vertical"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/remove_ads"
                                android:textAlignment="viewStart"
                                style="@style/MediumDarkText"/>
                        </LinearLayout>
                    </LinearLayout>
                    <LinearLayout
                        android:orientation="horizontal"
                        android:paddingTop="@dimen/go_premium_paddings"
                        android:paddingBottom="@dimen/go_premium_paddings"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">
                        <ImageView
                            android:layout_gravity="center_vertical"
                            android:layout_width="@dimen/go_premium_icon_size"
                            android:layout_height="@dimen/go_premium_icon_size"
                            android:src="@drawable/ic_unlimited_proj_unlock"/>
                        <LinearLayout
                            android:layout_gravity="center_vertical"
                            android:orientation="vertical"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="24dp">
                            <TextView
                                android:textSize="@dimen/go_premium_items_text_size"
                                android:textColor="#403c3c"
                                android:layout_gravity="start|center_vertical"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/unlimited_projects_count"
                                android:textAlignment="viewStart"
                                style="@style/MediumDarkText"/>
                        </LinearLayout>
                    </LinearLayout>
                    <LinearLayout
                        android:orientation="horizontal"
                        android:paddingTop="@dimen/go_premium_paddings"
                        android:paddingBottom="@dimen/go_premium_paddings"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">
                        <ImageView
                            android:layout_gravity="center_vertical"
                            android:layout_width="@dimen/go_premium_icon_size"
                            android:layout_height="@dimen/go_premium_icon_size"
                            android:src="@drawable/ic_unlcok_cut"/>
                        <LinearLayout
                            android:layout_gravity="center_vertical"
                            android:orientation="vertical"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="24dp">
                            <TextView
                                android:textSize="@dimen/go_premium_items_text_size"
                                android:textColor="#403c3c"
                                android:layout_gravity="start|center_vertical"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/cut_copy_paste_work_much_easier"
                                android:textAlignment="viewStart"
                                style="@style/MediumDarkText"/>
                        </LinearLayout>
                    </LinearLayout>
                    <LinearLayout
                        android:orientation="horizontal"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">
                        <ImageView
                            android:layout_gravity="center_vertical"
                            android:layout_width="@dimen/go_premium_icon_size"
                            android:layout_height="@dimen/go_premium_icon_size"
                            android:src="@drawable/ic_unlimited_connect"/>
                        <LinearLayout
                            android:layout_gravity="center_vertical"
                            android:orientation="vertical"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="24dp">
                            <TextView
                                android:textSize="@dimen/go_premium_items_text_size"
                                android:textColor="#403c3c"
                                android:layout_gravity="start|center_vertical"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/unlimited_io_connections_for_embedding"
                                android:textAlignment="viewStart"
                                style="@style/MediumDarkText"/>
                        </LinearLayout>
                    </LinearLayout>
                    <LinearLayout
                        android:orientation="horizontal"
                        android:paddingTop="@dimen/go_premium_paddings"
                        android:paddingBottom="@dimen/go_premium_paddings"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">
                        <ImageView
                            android:layout_gravity="center_vertical"
                            android:layout_width="@dimen/go_premium_icon_size"
                            android:layout_height="@dimen/go_premium_icon_size"
                            android:src="@drawable/ic_unlimited_elements_unlock"/>
                        <LinearLayout
                            android:layout_gravity="center_vertical"
                            android:orientation="vertical"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="24dp">
                            <TextView
                                android:textSize="@dimen/go_premium_items_text_size"
                                android:textColor="#403c3c"
                                android:layout_gravity="start|center_vertical"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/unlimited_elements_for_any_type"
                                android:textAlignment="viewStart"
                                style="@style/MediumDarkText"/>
                        </LinearLayout>
                    </LinearLayout>
                    <LinearLayout
                        android:orientation="horizontal"
                        android:paddingTop="@dimen/go_premium_paddings"
                        android:paddingBottom="@dimen/go_premium_paddings"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">
                        <ImageView
                            android:layout_gravity="center_vertical"
                            android:layout_width="@dimen/go_premium_icon_size"
                            android:layout_height="@dimen/go_premium_icon_size"
                            android:src="@drawable/ic_redo_arrow"/>
                        <LinearLayout
                            android:layout_gravity="center_vertical"
                            android:orientation="vertical"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="24dp">
                            <TextView
                                android:textSize="@dimen/go_premium_items_text_size"
                                android:textColor="#403c3c"
                                android:layout_gravity="start|center_vertical"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/undo_and_redo_commands"
                                android:textAlignment="viewStart"
                                style="@style/MediumDarkText"/>
                        </LinearLayout>
                    </LinearLayout>
                    <LinearLayout
                        android:orientation="horizontal"
                        android:paddingTop="@dimen/go_premium_paddings"
                        android:paddingBottom="@dimen/go_premium_paddings"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">
                        <ImageView
                            android:layout_gravity="center_vertical"
                            android:layout_width="@dimen/go_premium_icon_size"
                            android:layout_height="@dimen/go_premium_icon_size"
                            android:src="@drawable/ic_snapping_unlock"/>
                        <LinearLayout
                            android:layout_gravity="center_vertical"
                            android:orientation="vertical"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="24dp">
                            <TextView
                                android:textSize="@dimen/go_premium_items_text_size"
                                android:textColor="#403c3c"
                                android:layout_gravity="start|center_vertical"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/snapping_align_elements_quickly"
                                android:textAlignment="viewStart"
                                style="@style/MediumDarkText"/>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
    <LinearLayout
        android:layout_gravity="center"
        android:orientation="vertical"
        android:id="@+id/pricing_success"
        android:paddingTop="48dp"
        android:paddingBottom="48dp"
        android:visibility="gone"
        android:layout_width="200dp"
        android:layout_height="wrap_content">
        <ImageView
            android:layout_width="200dp"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_check_checked"
            android:adjustViewBounds="true"/>
        <TextView
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="48dp"
            android:text="@string/success"
            style="@style/VeryBigDarkText"/>
    </LinearLayout>
</com.duracodefactory.logiccircuitsimulatorpro.ui.GoPremiumLayout>
