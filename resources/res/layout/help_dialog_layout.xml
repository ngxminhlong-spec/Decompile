<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center"
    android:id="@+id/helper_main_dialog_container"
    android:background="#32d3a8"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:elevation="8dp"
    app:cardCornerRadius="4dp">
    <LinearLayout
        android:orientation="vertical"
        android:background="@color/recents_bg"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_gravity="center_horizontal"
            android:id="@+id/help_dialog_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/getting_started"
            android:fontFamily="sans-serif-condensed"
            style="@style/MediumDarkText"/>
        <FrameLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp">
            <FrameLayout
                android:layout_gravity="end|bottom"
                android:id="@+id/help_dialog_continue"
                android:background="@drawable/rounded_outline_bg_accent"
                android:paddingLeft="24dp"
                android:paddingTop="8dp"
                android:paddingRight="24dp"
                android:paddingBottom="8dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <TextView
                    android:textStyle="bold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/continue_text"
                    android:textAllCaps="true"
                    android:fontFamily="sans-serif-condensed"
                    style="@style/SmallDarkText"/>
            </FrameLayout>
            <FrameLayout
                android:layout_gravity="start|bottom"
                android:id="@+id/help_dialog_don_show"
                android:paddingLeft="12dp"
                android:paddingTop="8dp"
                android:paddingRight="12dp"
                android:paddingBottom="8dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/don_t_show_again"
                    android:textAllCaps="true"
                    android:fontFamily="sans-serif-condensed"
                    style="@style/SmallDarkText"/>
            </FrameLayout>
        </FrameLayout>
        <FrameLayout
            android:layout_width="@dimen/help_video_width"
            android:layout_height="@dimen/help_video_width"
            android:layout_marginTop="16dp">
            <VideoView
                android:id="@+id/help_dialog_video"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <View
                android:background="?attr/colorAccent"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:alpha="0.3"/>
        </FrameLayout>
        <FrameLayout
            android:id="@+id/help_dialog_seekbar"
            android:background="?attr/colorAccent"
            android:layout_width="wrap_content"
            android:layout_height="4dp"
            android:elevation="1dp"/>
        <TextView
            android:textSize="14sp"
            android:layout_gravity="center_horizontal"
            android:id="@+id/help_dialog_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            android:fontFamily="sans-serif-medium"
            style="@style/MediumDarkText"/>
    </LinearLayout>
</androidx.cardview.widget.CardView>
