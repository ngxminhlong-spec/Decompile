<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:paddingTop="8dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp">
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/price_container"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <FrameLayout
                android:visibility="visible"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp">
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_check_empty"
                    android:alpha="0.1"/>
                <FrameLayout
                    android:id="@+id/price_checked"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <View
                        android:layout_gravity="center"
                        android:background="@drawable/avatar_shadow"
                        android:layout_width="20dp"
                        android:layout_height="20dp"/>
                    <ImageView
                        android:layout_gravity="center_vertical"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_check_checked"/>
                </FrameLayout>
            </FrameLayout>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp">
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">
                        <TextView
                            android:textSize="14sp"
                            android:textStyle="normal"
                            android:textColor="#444444"
                            android:layout_gravity="start"
                            android:id="@+id/price_type_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Montly Subscription"
                            android:fontFamily="sans-serif"
                            style="@style/MediumDarkText"/>
                        <FrameLayout
                            android:id="@+id/popular"
                            android:background="@drawable/popular_bg"
                            android:paddingTop="2dp"
                            android:paddingBottom="2dp"
                            android:visibility="visible"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:paddingStart="4dp"
                            android:paddingEnd="4dp">
                            <TextView
                                android:textSize="10sp"
                                android:textStyle="normal"
                                android:textColor="#cc000000"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/popular"
                                android:textAllCaps="true"
                                android:fontFamily="sans-serif-medium"/>
                        </FrameLayout>
                    </LinearLayout>
                    <LinearLayout
                        android:layout_gravity="end"
                        android:orientation="vertical"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">
                        <RelativeLayout
                            android:layout_gravity="end"
                            android:id="@+id/discount_container"
                            android:visibility="visible"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content">
                            <TextView
                                android:textSize="16sp"
                                android:textStyle="normal"
                                android:textColor="#bb000000"
                                android:layout_gravity="end"
                                android:id="@+id/discount_text"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="BGN 14.99"
                                android:fontFamily="sans-serif-medium"
                                android:paddingStart="4dp"
                                style="@style/MediumDarkText"/>
                            <View
                                android:layout_gravity="center"
                                android:background="@color/accent_1"
                                android:layout_width="match_parent"
                                android:layout_height="2dp"
                                android:layout_centerInParent="true"
                                android:layout_toStartOf="@+id/discount_text"
                                android:layout_toEndOf="@+id/discount_text"/>
                        </RelativeLayout>
                        <TextView
                            android:textSize="14sp"
                            android:textStyle="normal"
                            android:textColor="#bb000000"
                            android:layout_gravity="end"
                            android:id="@+id/price_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="USD 4.99"
                            android:fontFamily="sans-serif-medium"
                            style="@style/MediumDarkText"/>
                        <TextView
                            android:textSize="12sp"
                            android:textStyle="normal"
                            android:textColor="#88000000"
                            android:gravity="end"
                            android:layout_gravity="end"
                            android:id="@+id/price_type_additional_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Monthly"
                            android:fontFamily="sans-serif"/>
                    </LinearLayout>
                </FrameLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/discount_container2"
                    android:background="@drawable/discount_bg"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:elevation="4dp">
                    <TextView
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="#ffffff"
                        android:id="@+id/offer_ends_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Offer ends"
                        android:textAllCaps="true"
                        android:fontFamily="sans-serif-medium"/>
                    <TextView
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="#ffffff"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/upto"
                        android:textAllCaps="true"
                        android:fontFamily="sans-serif-medium"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
