<?xml version="1.0" encoding="utf-8"?>
<com.duracodefactory.logiccircuitsimulatorpro.ui.CircuitExploreDialog xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@drawable/info_ballon_bg"
    android:focusable="true"
    android:clickable="true"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/header_container"
        android:clipChildren="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/title_container"
            android:background="@drawable/info_ballon_bg"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:elevation="4dp">
            <FrameLayout
                android:layout_gravity="center_vertical"
                android:id="@+id/explore_circuit_back"
                android:padding="12dp"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="8dp"
                android:foreground="@drawable/ripple">
                <View
                    android:layout_gravity="center_vertical"
                    android:background="@drawable/ic_left_arrow_dark"
                    android:layout_width="@dimen/toolbar_back_dimen"
                    android:layout_height="@dimen/toolbar_back_dimen"/>
            </FrameLayout>
            <TextView
                android:textSize="16sp"
                android:layout_gravity="start|center_vertical"
                android:id="@+id/explore_circuit_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:maxLength="30"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:textAlignment="viewStart"
                style="@style/MediumDarkText"/>
            <FrameLayout
                android:layout_gravity="center_vertical"
                android:id="@+id/explore_circuit_bino"
                android:padding="8dp"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"
                android:foreground="@drawable/ripple"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp">
                <View
                    android:layout_gravity="center_vertical"
                    android:background="@drawable/ic_binoc"
                    android:layout_width="24dp"
                    android:layout_height="24dp"/>
            </FrameLayout>
        </LinearLayout>
        <FrameLayout
            android:id="@+id/peek_label"
            android:background="?attr/colorAccent"
            android:padding="8dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textStyle="bold"
                android:textColor="@color/light_on_accent"
                android:layout_gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/peek_into_circuit"
                android:fontFamily="sans-serif-condensed"
                style="@style/NormalDarkText"/>
        </FrameLayout>
        <FrameLayout
            android:id="@+id/balloon_cont"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginStart="16dp"/>
    </LinearLayout>
    <LinearLayout
        android:layout_gravity="end|bottom"
        android:orientation="horizontal"
        android:id="@+id/download_btn"
        android:background="@drawable/rounded_no_outline_bg_accent_download"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:paddingStart="16dp"
        android:paddingEnd="24dp"
        android:layout_marginEnd="16dp"
        android:elevation="8dp">
        <ImageView
            android:layout_gravity="center_vertical"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/download_icon"
            android:tint="@color/header_bg"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/header_bg"
            android:layout_gravity="center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/save"
            android:textAllCaps="true"
            android:fontFamily="sans-serif-medium"
            android:layout_marginStart="12dp"/>
    </LinearLayout>
</com.duracodefactory.logiccircuitsimulatorpro.ui.CircuitExploreDialog>
