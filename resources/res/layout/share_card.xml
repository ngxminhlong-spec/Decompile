<?xml version="1.0" encoding="utf-8"?>
<com.duracodefactory.logiccircuitsimulatorpro.ui.ShareCard xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:background="@drawable/share_card_bg"
    android:paddingTop="12dp"
    android:paddingBottom="12dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginTop="12dp"
    android:layout_marginBottom="8dp"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:layout_marginStart="@dimen/recents_side_padding"
    android:layout_marginEnd="@dimen/recents_side_padding"
    android:elevation="4dp">
    <ImageView
        android:id="@+id/share_card_image"
        android:layout_width="wrap_content"
        android:layout_height="56dp"
        android:src="@drawable/ic_startup_third"
        android:adjustViewBounds="true"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="24dp">
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textStyle="bold"
                android:textColor="@color/dark_text"
                android:id="@+id/promo_card_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/timediagrams_title"
                android:textAllCaps="true"
                android:fontFamily="sans-serif-condensed"
                style="@style/NormalDarkText"/>
            <FrameLayout
                android:layout_gravity="end"
                android:id="@+id/share_card_close"
                android:padding="4dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <View
                    android:background="@drawable/ic_close"
                    android:layout_width="10dp"
                    android:layout_height="10dp"/>
            </FrameLayout>
        </FrameLayout>
        <TextView
            android:id="@+id/promo_card_desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/welcome_3_d"
            android:textAlignment="viewStart"
            style="@style/SmallDarkText"/>
    </LinearLayout>
</com.duracodefactory.logiccircuitsimulatorpro.ui.ShareCard>
