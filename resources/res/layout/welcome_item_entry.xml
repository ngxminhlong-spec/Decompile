<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_gravity="center"
    android:orientation="vertical"
    android:layout_width="@dimen/welcome_image_size"
    android:layout_height="wrap_content">
    <androidx.appcompat.widget.AppCompatImageView
        android:layout_gravity="center_horizontal"
        android:id="@+id/welcome_card_image"
        android:layout_width="@dimen/welcome_inner_image_size"
        android:layout_height="@dimen/welcome_inner_image_size"
        android:scaleType="fitCenter"/>
    <TextView
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#403c3c"
        android:layout_gravity="center_horizontal"
        android:id="@+id/welcome_card_maintext"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:fontFamily="sans-serif"
        android:textAlignment="center"/>
    <TextView
        android:textSize="16sp"
        android:textColor="#403c3c"
        android:layout_gravity="center_horizontal"
        android:id="@+id/welcome_card_secondarytext"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fontFamily="sans-serif-condensed"
        android:textAlignment="center"/>
</LinearLayout>
