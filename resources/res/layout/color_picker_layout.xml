<?xml version="1.0" encoding="utf-8"?>
<com.duracodefactory.logiccircuitsimulatorpro.ui.ColorPicker xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_gravity="center"
    android:orientation="vertical"
    android:paddingBottom="24dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:layout_gravity="center"
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <FrameLayout
                android:id="@+id/color1_container"
                android:padding="@dimen/theme_selector_padding"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <FrameLayout
                    android:background="@drawable/theme1_selector"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:elevation="@dimen/theme_circles_elevation"/>
            </FrameLayout>
            <FrameLayout
                android:id="@+id/color2_container"
                android:padding="@dimen/theme_selector_padding"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <FrameLayout
                    android:background="@drawable/theme2_selector"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:elevation="@dimen/theme_circles_elevation"/>
            </FrameLayout>
            <FrameLayout
                android:id="@+id/color3_container"
                android:padding="@dimen/theme_selector_padding"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <FrameLayout
                    android:background="@drawable/theme3_selector"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:elevation="@dimen/theme_circles_elevation"/>
            </FrameLayout>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <FrameLayout
                android:id="@+id/color4_container"
                android:padding="@dimen/theme_selector_padding"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <FrameLayout
                    android:background="@drawable/theme4_selector"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:elevation="@dimen/theme_circles_elevation"/>
            </FrameLayout>
            <FrameLayout
                android:id="@+id/color5_container"
                android:padding="@dimen/theme_selector_padding"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <FrameLayout
                    android:background="@drawable/theme5_selector"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:elevation="@dimen/theme_circles_elevation"/>
            </FrameLayout>
            <FrameLayout
                android:id="@+id/color6_container"
                android:padding="@dimen/theme_selector_padding"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <FrameLayout
                    android:background="@drawable/theme6_selector"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:elevation="@dimen/theme_circles_elevation"/>
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>
</com.duracodefactory.logiccircuitsimulatorpro.ui.ColorPicker>
