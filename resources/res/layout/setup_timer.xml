<?xml version="1.0" encoding="utf-8"?>
<com.duracodefactory.logiccircuitsimulatorpro.ui.TimerSetup xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:layout_gravity="center_horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/delayer"
        style="@style/BigDarkText"/>
    <View
        android:background="@color/separator_light"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginRight="16dp"/>
    <ImageView
        android:layout_gravity="center_horizontal"
        android:layout_width="100dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:src="@drawable/ic_learn_timer_icon"
        android:adjustViewBounds="true"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/timer_setup_interactive_container"
        android:visibility="gone"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/timer_delay"
                android:layout_marginStart="12dp"
                style="@style/MediumDarkText"/>
            <TextView
                android:textStyle="bold"
                android:id="@+id/setup_timer_delay_ms"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="3ms"
                android:layout_marginStart="8dp"
                style="@style/MediumDarkText"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp">
            <LinearLayout
                android:orientation="vertical"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layoutDirection="ltr"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp">
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textStyle="italic|bold"
                        android:layout_gravity="bottom"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="100ms"
                        android:layout_weight="1"
                        android:fontFamily="serif"
                        android:textAlignment="textStart"
                        style="@style/NormalDarkText"/>
                    <TextView
                        android:textStyle="italic|bold"
                        android:layout_gravity="bottom"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="120s"
                        android:layout_weight="1"
                        android:fontFamily="serif"
                        android:textAlignment="viewEnd"
                        style="@style/NormalDarkText"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="11dp"
                    android:layout_marginEnd="11dp">
                    <TextView
                        android:textStyle="italic|bold"
                        android:textColor="@color/dark_secondary_text"
                        android:layout_gravity="bottom"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="|"
                        android:fontFamily="serif"
                        android:textAlignment="center"
                        style="@style/VerySmallDarkText"/>
                    <TextView
                        android:textSize="5dp"
                        android:textStyle="italic|bold"
                        android:textColor="@color/dark_secondary_text"
                        android:layout_gravity="bottom"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="|"
                        android:layout_weight="1"
                        android:fontFamily="serif"
                        android:textAlignment="textEnd"
                        style="@style/VerySmallDarkText"/>
                    <TextView
                        android:textStyle="italic|bold"
                        android:textColor="@color/dark_secondary_text"
                        android:layout_gravity="bottom"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="|"
                        android:layout_weight="2"
                        android:fontFamily="serif"
                        android:textAlignment="center"
                        style="@style/VerySmallDarkText"/>
                    <TextView
                        android:textSize="5dp"
                        android:textStyle="italic|bold"
                        android:textColor="@color/dark_secondary_text"
                        android:layout_gravity="bottom"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="|"
                        android:layout_weight="1"
                        android:fontFamily="serif"
                        android:textAlignment="textStart"
                        style="@style/VerySmallDarkText"/>
                    <TextView
                        android:textStyle="italic|bold"
                        android:textColor="@color/dark_secondary_text"
                        android:layout_gravity="bottom"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="|"
                        android:fontFamily="serif"
                        android:textAlignment="center"
                        style="@style/VerySmallDarkText"/>
                </LinearLayout>
                <com.duracodefactory.logiccircuitsimulatorpro.ui.Slider
                    android:id="@+id/timer_delay_slider"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    app:positionsCount="20">
                    <View
                        android:layout_gravity="center"
                        android:background="@drawable/dlg_button_bg"
                        android:layout_width="match_parent"
                        android:layout_height="8dp"/>
                    <View
                        android:id="@+id/handle"
                        android:background="@drawable/slider_handle"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:elevation="2dp"/>
                </com.duracodefactory.logiccircuitsimulatorpro.ui.Slider>
            </LinearLayout>
        </LinearLayout>
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp">
            <Button
                android:layout_gravity="center"
                android:id="@+id/timer_setup_submit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/apply"/>
        </FrameLayout>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp">
        <TextView
            android:layout_gravity="center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/timer_on"
            style="@style/BigDarkText"/>
        <View
            android:layout_gravity="center_vertical"
            android:background="@drawable/ic_timer_element_on"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="8dp"/>
    </LinearLayout>
    <TextView
        android:paddingBottom="24dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/timer_on_explanation"
        style="@style/NormalDarkText"/>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp">
        <TextView
            android:layout_gravity="center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/timer_off"
            style="@style/BigDarkText"/>
        <View
            android:layout_gravity="center_vertical"
            android:background="@drawable/ic_timer_element_off"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="8dp"/>
    </LinearLayout>
    <TextView
        android:paddingBottom="24dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/timer_off_explanation"
        style="@style/NormalDarkText"/>
    <TextView
        android:paddingBottom="24dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/timer_555_main_text"
        style="@style/NormalDarkText"/>
    <TextView
        android:textStyle="bold"
        android:layout_gravity="center_horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/simplified_scheme"
        android:textAllCaps="true"
        style="@style/SmallDarkText"/>
    <FrameLayout
        android:layout_gravity="center_horizontal"
        android:background="@drawable/learn_scheme_bg"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp">
        <ImageView
            android:layout_width="@dimen/learn_scheme_size"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            android:src="@drawable/ic_555_schemes"
            android:adjustViewBounds="true"/>
    </FrameLayout>
</com.duracodefactory.logiccircuitsimulatorpro.ui.TimerSetup>
