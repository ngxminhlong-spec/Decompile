<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="4dp"
    android:layout_marginBottom="4dp"
    android:layout_marginStart="8dp"
    android:layout_marginEnd="8dp">
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="4dp">
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/ic_image"
            android:padding="5dp"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_ic_new_for_recents"
            android:scaleType="centerCrop"
            android:tint="?attr/colorAccent"/>
        <LinearLayout
            android:orientation="vertical"
            android:paddingBottom="4dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="24dp"
            android:paddingEnd="4dp">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp">
                <TextView
                    android:ellipsize="marquee"
                    android:layout_gravity="start|center_vertical"
                    android:id="@+id/insert_project_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-condensed-medium"
                    android:textAlignment="viewStart"
                    style="@style/MediumDarkText"/>
            </LinearLayout>
            <View
                android:background="@color/separator_light"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="2dp"
                android:layout_marginEnd="12dp"/>
            <LinearLayout
                android:gravity="start|center_vertical"
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <View
                    android:background="@drawable/ic_recents_new_conn_count"
                    android:layout_width="12dp"
                    android:layout_height="12dp"/>
                <TextView
                    android:textColor="@color/dark_secondary_text"
                    android:ellipsize="marquee"
                    android:id="@+id/elem_num"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="4dp"
                    style="@style/SmallDarkText"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="start|center_vertical"
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <View
                    android:background="@drawable/ic_connection_new_recents"
                    android:layout_width="12dp"
                    android:layout_height="12dp"/>
                <TextView
                    android:textColor="@color/dark_secondary_text"
                    android:ellipsize="marquee"
                    android:id="@+id/conn_num"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="4dp"
                    style="@style/SmallDarkText"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
