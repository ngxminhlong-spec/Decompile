<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingTop="8dp"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="horizontal"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/ic_image"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_timing_control"
            android:scaleType="centerCrop"
            android:layout_marginStart="16dp"/>
        <LinearLayout
            android:layout_gravity="center_vertical"
            android:orientation="vertical"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="16dp"
            android:paddingEnd="12dp">
            <LinearLayout
                android:layout_gravity="center_vertical"
                android:orientation="horizontal"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">
                    <TextView
                        android:ellipsize="marquee"
                        android:layout_gravity="center_vertical"
                        android:id="@+id/timediagram_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Time Diagram 1 asdaskjdnaskjdnakjdnakjnkjandkasjndkandknkdnakjdnakdnakdnakdnkajndk"
                        android:singleLine="true"
                        android:fontFamily="sans-serif-medium"
                        style="@style/MediumDarkText"/>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <TextView
                            android:textColor="@color/dark_secondary_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/entries"
                            android:fontFamily="sans-serif-medium"
                            style="@style/SmallDarkText"/>
                        <TextView
                            android:textColor="@color/dark_secondary_text"
                            android:layout_gravity="center_vertical"
                            android:id="@+id/timediagram_entries_num"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:fontFamily="sans-serif-medium"
                            android:layout_marginStart="4dp"
                            style="@style/SmallDarkText"/>
                    </LinearLayout>
                </LinearLayout>
                <FrameLayout
                    android:layout_gravity="center_vertical"
                    android:id="@+id/timediagram_rename"
                    android:padding="8dp"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:foreground="@drawable/ripple">
                    <View
                        android:background="@drawable/ic_edit_name"
                        android:layout_width="18dp"
                        android:layout_height="18dp"/>
                </FrameLayout>
                <FrameLayout
                    android:layout_gravity="center_vertical"
                    android:id="@+id/timediagram_delete"
                    android:padding="8dp"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:foreground="@drawable/ripple">
                    <View
                        android:background="@drawable/ic_delete_circle"
                        android:layout_width="18dp"
                        android:layout_height="18dp"/>
                </FrameLayout>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="12dp">
                <LinearLayout
                    android:orientation="vertical"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">
                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/entries"
                            style="@style/VerySmallDarkText"/>
                        <TextView
                            android:textStyle="bold"
                            android:ellipsize="marquee"
                            android:id="@+id/timediagram_entries"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:singleLine="true"
                            android:layout_marginStart="4dp"
                            style="@style/VerySmallDarkText"/>
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/steps"
                            style="@style/VerySmallDarkText"/>
                        <TextView
                            android:textStyle="bold"
                            android:id="@+id/timediagram_steps"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:layout_marginStart="4dp"
                            style="@style/VerySmallDarkText"/>
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/length"
                            style="@style/VerySmallDarkText"/>
                        <TextView
                            android:textStyle="bold"
                            android:id="@+id/timediagram_lenght"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:layout_marginStart="4dp"
                            style="@style/VerySmallDarkText"/>
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <Switch
                        android:layout_gravity="center"
                        android:id="@+id/timediagram_show_pins"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/show_pins_on_circuit"
                        style="@style/VerySmallDarkText"/>
                </LinearLayout>
            </LinearLayout>
            <View
                android:layout_gravity="bottom"
                android:background="@color/separator_light"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="8dp"/>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
