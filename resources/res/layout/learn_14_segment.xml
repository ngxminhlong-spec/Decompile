<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:layout_gravity="center_horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/fourteen_segment_display"
        style="@style/BigDarkText"/>
    <View
        android:background="@color/separator_light"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginRight="16dp"/>
    <FrameLayout
        android:layout_gravity="center_horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp">
        <ImageView
            android:layout_width="@dimen/learn_element_size"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_learn_14segemnt"
            android:adjustViewBounds="true"/>
    </FrameLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/led_matrix_color_picker_container"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp">
        <TextView
            android:textStyle="bold"
            android:layout_gravity="center_horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="@string/change_color"
            style="@style/MediumDarkText"/>
        <include
            android:id="@+id/color_picker_settings"
            layout="@layout/color_picker_layout_info_selector"/>
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">
            <Button
                android:layout_gravity="center"
                android:id="@+id/settings_color_setup_submit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/apply"/>
        </FrameLayout>
    </LinearLayout>
    <TextView
        android:layout_gravity="center_horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/learn_14_segment_main_text"
        style="@style/NormalDarkText"/>
</LinearLayout>
