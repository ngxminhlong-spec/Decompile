<?xml version="1.0" encoding="utf-8"?>
<com.duracodefactory.logiccircuitsimulatorpro.ui.IcSetup xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="16dp"
        android:layout_marginEnd="16dp">
        <Button
            android:layout_gravity="end"
            android:id="@+id/io_setup_help_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/help"
            app:icon="@drawable/ic_help_io"
            app:iconSize="16dp"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>
    </FrameLayout>
    <HorizontalScrollView
        android:layout_gravity="center_horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="vertical"
            android:paddingBottom="4dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <LinearLayout
                android:layout_gravity="center_horizontal"
                android:orientation="horizontal"
                android:id="@+id/top_nodes"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/setup_nodes_height"/>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/middle_layer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layoutDirection="ltr">
                <LinearLayout
                    android:layout_gravity="center_vertical"
                    android:orientation="vertical"
                    android:id="@+id/left_nodes"
                    android:layout_width="@dimen/setup_nodes_height"
                    android:layout_height="wrap_content"/>
                <FrameLayout
                    android:id="@+id/scheme"
                    android:background="@drawable/ic_setup_scheme_bg"
                    android:padding="8dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textStyle="bold"
                        android:ellipsize="marquee"
                        android:layout_gravity="center"
                        android:id="@+id/ic_setup_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_margin="28dp"
                        android:maxLength="10"
                        style="@style/NormalDarkText"/>
                    <LinearLayout
                        android:layout_gravity="top|center_horizontal"
                        android:orientation="horizontal"
                        android:id="@+id/top_labels"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_marginEnd="16dp"/>
                    <LinearLayout
                        android:layout_gravity="center"
                        android:orientation="vertical"
                        android:id="@+id/left_labels"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:layout_marginBottom="16dp"/>
                    <LinearLayout
                        android:layout_gravity="center"
                        android:orientation="vertical"
                        android:id="@+id/right_labels"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:layout_marginBottom="16dp"/>
                    <LinearLayout
                        android:layout_gravity="bottom|center_horizontal"
                        android:orientation="horizontal"
                        android:id="@+id/bottom_labels"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_marginEnd="16dp"/>
                </FrameLayout>
                <LinearLayout
                    android:layout_gravity="center_vertical"
                    android:orientation="vertical"
                    android:id="@+id/right_nodes"
                    android:layout_width="@dimen/setup_nodes_height"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
            <LinearLayout
                android:layout_gravity="center_horizontal"
                android:orientation="horizontal"
                android:id="@+id/bottom_nodes"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/setup_nodes_height"/>
        </LinearLayout>
    </HorizontalScrollView>
    <LinearLayout
        android:layout_gravity="center_horizontal"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="24dp"
        android:layout_weight="1">
        <TextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_gravity="center_horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/io_list"
            android:fontFamily="sans-serif-condensed"
            style="@style/NormalDarkText"/>
        <View
            android:background="@color/separator_medium"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="16dp"/>
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">
            <Button
                android:layout_gravity="center"
                android:id="@+id/add"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/add_io_connection"
                app:icon="@drawable/ic_node_holder_add"
                style="@style/Widget.MaterialComponents.Button.UnelevatedButton"/>
        </FrameLayout>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/inputs_recycler"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="8dp"/>
    </LinearLayout>
</com.duracodefactory.logiccircuitsimulatorpro.ui.IcSetup>
