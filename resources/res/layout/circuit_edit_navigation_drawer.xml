<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/recents_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ScrollView
        android:background="@color/recents_bg"
        android:paddingBottom="48dp"
        android:scrollbars="none"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="vertical"
            android:background="@color/recents_bg"
            android:paddingTop="24dp"
            android:clipChildren="true"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <FrameLayout
                android:background="@color/recents_bg"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="@dimen/header_toolbar_height">
                <LinearLayout
                    android:gravity="center_vertical"
                    android:layout_gravity="start|center_vertical"
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="8dp"
                    android:layout_marginStart="24dp"
                    android:layout_marginEnd="24dp">
                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">
                            <com.google.android.material.textfield.TextInputEditText
                                android:textSize="14sp"
                                android:id="@+id/project_name"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="@string/project_name"
                                android:maxLines="1"
                                android:inputType="text"/>
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>
                </LinearLayout>
            </FrameLayout>
            <View
                android:background="@color/separator_light"
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:layout_marginBottom="8dp"/>
            <FrameLayout
                android:id="@+id/drawer_go_premium"
                android:padding="12dp"
                android:clipChildren="true"
                android:clipToPadding="true"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:foreground="@drawable/ripple">
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="12dp">
                    <View
                        android:layout_gravity="center_vertical"
                        android:background="@drawable/ic_pro_nav"
                        android:layout_width="@dimen/navigation_icon_dimen"
                        android:layout_height="@dimen/navigation_icon_dimen"/>
                    <TextView
                        android:layout_gravity="center_vertical"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/unlock_full_version"
                        android:layout_marginStart="32dp"
                        style="@style/RecentsNavItemsTextStyle"/>
                </LinearLayout>
            </FrameLayout>
            <FrameLayout
                android:id="@+id/electro"
                android:padding="12dp"
                android:clipChildren="true"
                android:clipToPadding="true"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:foreground="@drawable/ripple">
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="12dp">
                    <View
                        android:layout_gravity="center_vertical"
                        android:background="@drawable/ic_calcs_icon"
                        android:layout_width="@dimen/navigation_icon_dimen"
                        android:layout_height="@dimen/navigation_icon_dimen"/>
                    <TextView
                        android:layout_gravity="center_vertical"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ElectroBox"
                        android:layout_marginStart="32dp"
                        style="@style/RecentsNavItemsTextStyle"/>
                </LinearLayout>
            </FrameLayout>
            <FrameLayout
                android:id="@+id/drawer_go_premium_old_user"
                android:padding="12dp"
                android:clipChildren="true"
                android:clipToPadding="true"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:foreground="@drawable/ripple">
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="12dp">
                    <View
                        android:layout_gravity="center_vertical"
                        android:background="@drawable/ic_support_us_buy"
                        android:layout_width="@dimen/navigation_icon_dimen"
                        android:layout_height="@dimen/navigation_icon_dimen"/>
                    <TextView
                        android:layout_gravity="center_vertical"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/support_us"
                        android:layout_marginStart="32dp"
                        style="@style/RecentsNavItemsTextStyle"/>
                </LinearLayout>
            </FrameLayout>
            <FrameLayout
                android:id="@+id/drawer_export_project"
                android:padding="12dp"
                android:clipChildren="true"
                android:clipToPadding="true"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:foreground="@drawable/ripple">
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="12dp">
                    <View
                        android:layout_gravity="center_vertical"
                        android:background="@drawable/ic_export_nav"
                        android:layout_width="@dimen/navigation_icon_dimen"
                        android:layout_height="@dimen/navigation_icon_dimen"/>
                    <TextView
                        android:layout_gravity="center_vertical"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/export"
                        android:layout_marginStart="32dp"
                        style="@style/RecentsNavItemsTextStyle"/>
                </LinearLayout>
            </FrameLayout>
            <FrameLayout
                android:id="@+id/drawer_export_project_image"
                android:padding="12dp"
                android:clipChildren="true"
                android:clipToPadding="true"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:foreground="@drawable/ripple">
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="12dp">
                    <View
                        android:layout_gravity="center_vertical"
                        android:background="@drawable/ic_export_image_nav"
                        android:layout_width="@dimen/navigation_icon_dimen"
                        android:layout_height="@dimen/navigation_icon_dimen"/>
                    <TextView
                        android:layout_gravity="center_vertical"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/export_as_image"
                        android:layout_marginStart="32dp"
                        style="@style/RecentsNavItemsTextStyle"/>
                </LinearLayout>
            </FrameLayout>
            <FrameLayout
                android:id="@+id/drawer_dark_mode"
                android:padding="12dp"
                android:clickable="true"
                android:clipChildren="true"
                android:clipToPadding="true"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:foreground="@drawable/ripple">
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="12dp">
                    <View
                        android:layout_gravity="center_vertical"
                        android:background="@drawable/ic_dark_mode_nav"
                        android:layout_width="@dimen/navigation_icon_dimen"
                        android:layout_height="@dimen/navigation_icon_dimen"/>
                    <TextView
                        android:layout_gravity="center_vertical"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/dark_mode"
                        android:layout_marginStart="32dp"
                        style="@style/RecentsNavItemsTextStyle"/>
                </LinearLayout>
                <LinearLayout
                    android:layout_gravity="end"
                    android:orientation="horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="10sp"
                        android:layout_gravity="center_vertical"
                        android:id="@+id/dark_mode_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/on"
                        android:fontFamily="sans-serif-medium"
                        android:layout_marginEnd="4dp"
                        style="@style/VerySmallDarkText"/>
                    <Switch
                        android:layout_gravity="end"
                        android:id="@+id/dark_mode_swtich"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </LinearLayout>
            </FrameLayout>
            <FrameLayout
                android:id="@+id/drawer_theme"
                android:padding="12dp"
                android:clipChildren="true"
                android:clipToPadding="true"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:foreground="@drawable/ripple">
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="12dp">
                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">
                        <View
                            android:layout_gravity="center_vertical"
                            android:background="@drawable/ic_themes_nav"
                            android:layout_width="@dimen/navigation_icon_dimen"
                            android:layout_height="@dimen/navigation_icon_dimen"/>
                        <TextView
                            android:layout_gravity="center_vertical"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/theme"
                            android:layout_marginStart="32dp"
                            style="@style/RecentsNavItemsTextStyle"/>
                    </LinearLayout>
                    <LinearLayout
                        android:orientation="vertical"
                        android:paddingTop="4dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingStart="48dp">
                        <LinearLayout
                            android:orientation="horizontal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content">
                            <FrameLayout
                                android:id="@+id/theme1_container"
                                android:padding="@dimen/theme_selector_padding"
                                android:clipChildren="false"
                                android:clipToPadding="false"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content">
                                <FrameLayout
                                    android:id="@+id/theme1"
                                    android:background="@drawable/theme1_selector"
                                    android:layout_width="@dimen/theme_selector_size"
                                    android:layout_height="@dimen/theme_selector_size"
                                    android:elevation="@dimen/theme_circles_elevation"/>
                            </FrameLayout>
                            <FrameLayout
                                android:id="@+id/theme2_container"
                                android:padding="@dimen/theme_selector_padding"
                                android:clipChildren="false"
                                android:clipToPadding="false"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content">
                                <FrameLayout
                                    android:id="@+id/theme2"
                                    android:background="@drawable/theme2_selector"
                                    android:layout_width="@dimen/theme_selector_size"
                                    android:layout_height="@dimen/theme_selector_size"
                                    android:elevation="@dimen/theme_circles_elevation"/>
                            </FrameLayout>
                            <FrameLayout
                                android:id="@+id/theme3_container"
                                android:padding="@dimen/theme_selector_padding"
                                android:clipChildren="false"
                                android:clipToPadding="false"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content">
                                <FrameLayout
                                    android:id="@+id/theme3"
                                    android:background="@drawable/theme3_selector"
                                    android:layout_width="@dimen/theme_selector_size"
                                    android:layout_height="@dimen/theme_selector_size"
                                    android:elevation="@dimen/theme_circles_elevation"/>
                            </FrameLayout>
                            <FrameLayout
                                android:id="@+id/theme8_container"
                                android:padding="@dimen/theme_selector_padding"
                                android:clipChildren="false"
                                android:clipToPadding="false"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content">
                                <FrameLayout
                                    android:id="@+id/theme8"
                                    android:background="@drawable/theme8_selector"
                                    android:layout_width="@dimen/theme_selector_size"
                                    android:layout_height="@dimen/theme_selector_size"
                                    android:elevation="@dimen/theme_circles_elevation"/>
                            </FrameLayout>
                        </LinearLayout>
                        <LinearLayout
                            android:orientation="horizontal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content">
                            <FrameLayout
                                android:id="@+id/theme7_container"
                                android:padding="@dimen/theme_selector_padding"
                                android:clipChildren="false"
                                android:clipToPadding="false"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content">
                                <FrameLayout
                                    android:id="@+id/theme7"
                                    android:background="@drawable/theme7_selector"
                                    android:layout_width="@dimen/theme_selector_size"
                                    android:layout_height="@dimen/theme_selector_size"
                                    android:elevation="@dimen/theme_circles_elevation"/>
                            </FrameLayout>
                            <FrameLayout
                                android:id="@+id/theme4_container"
                                android:padding="@dimen/theme_selector_padding"
                                android:clipChildren="false"
                                android:clipToPadding="false"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content">
                                <FrameLayout
                                    android:id="@+id/theme4"
                                    android:background="@drawable/theme4_selector"
                                    android:layout_width="@dimen/theme_selector_size"
                                    android:layout_height="@dimen/theme_selector_size"
                                    android:elevation="@dimen/theme_circles_elevation"/>
                            </FrameLayout>
                            <FrameLayout
                                android:id="@+id/theme5_container"
                                android:padding="@dimen/theme_selector_padding"
                                android:clipChildren="false"
                                android:clipToPadding="false"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content">
                                <FrameLayout
                                    android:id="@+id/theme5"
                                    android:background="@drawable/theme5_selector"
                                    android:layout_width="@dimen/theme_selector_size"
                                    android:layout_height="@dimen/theme_selector_size"
                                    android:elevation="@dimen/theme_circles_elevation"/>
                            </FrameLayout>
                            <FrameLayout
                                android:id="@+id/theme6_container"
                                android:padding="@dimen/theme_selector_padding"
                                android:clipChildren="false"
                                android:clipToPadding="false"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content">
                                <FrameLayout
                                    android:id="@+id/theme6"
                                    android:background="@drawable/theme6_selector"
                                    android:layout_width="@dimen/theme_selector_size"
                                    android:layout_height="@dimen/theme_selector_size"
                                    android:elevation="@dimen/theme_circles_elevation"/>
                            </FrameLayout>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </FrameLayout>
            <FrameLayout
                android:padding="12dp"
                android:clipChildren="true"
                android:clipToPadding="true"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:foreground="@drawable/ripple">
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="12dp">
                    <View
                        android:layout_gravity="top"
                        android:background="@drawable/ic_grid_settings_nav"
                        android:layout_width="@dimen/navigation_icon_dimen"
                        android:layout_height="@dimen/navigation_icon_dimen"/>
                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <TextView
                            android:layout_gravity="start|center_vertical"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/grid_settings"
                            android:layout_marginStart="32dp"
                            style="@style/RecentsNavItemsTextStyle"/>
                        <LinearLayout
                            android:layout_gravity="start"
                            android:orientation="horizontal"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp">
                            <TextView
                                android:textSize="11sp"
                                android:layout_gravity="center_vertical"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/units"
                                android:layout_weight="1"
                                android:fontFamily="sans-serif-medium"
                                android:textAlignment="viewStart"
                                android:layout_marginStart="56dp"
                                android:layout_marginEnd="4dp"
                                style="@style/SmallDarkText"/>
                            <RadioGroup
                                android:orientation="horizontal"
                                android:id="@+id/units_radio_group"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content">
                                <RadioButton
                                    android:textSize="10sp"
                                    android:id="@+id/mm_toggle"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/mm"
                                    android:fontFamily="sans-serif-medium"
                                    style="@style/SmallerDarkText"/>
                                <RadioButton
                                    android:textSize="10sp"
                                    android:id="@+id/inches_toggle"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/inch"
                                    android:fontFamily="sans-serif-medium"
                                    style="@style/SmallerDarkText"/>
                            </RadioGroup>
                        </LinearLayout>
                        <FrameLayout
                            android:orientation="horizontal"
                            android:paddingTop="4dp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">
                            <TextView
                                android:textSize="11sp"
                                android:layout_gravity="start|center_vertical"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/grid_visible"
                                android:layout_weight="1"
                                android:fontFamily="sans-serif-medium"
                                android:layout_marginStart="56dp"
                                android:layout_marginEnd="4dp"
                                style="@style/SmallDarkText"/>
                            <LinearLayout
                                android:layout_gravity="end"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content">
                                <TextView
                                    android:textSize="10sp"
                                    android:layout_gravity="start|center_vertical"
                                    android:id="@+id/grid_visible"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/on"
                                    android:fontFamily="sans-serif-medium"
                                    android:layout_marginEnd="4dp"
                                    style="@style/VerySmallDarkText"/>
                                <Switch
                                    android:layout_gravity="end"
                                    android:id="@+id/grid_visible_switch"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"/>
                            </LinearLayout>
                        </FrameLayout>
                    </LinearLayout>
                </LinearLayout>
            </FrameLayout>
            <FrameLayout
                android:id="@+id/snapping"
                android:padding="12dp"
                android:clickable="true"
                android:clipChildren="true"
                android:clipToPadding="true"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:foreground="@drawable/ripple">
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="12dp">
                    <View
                        android:layout_gravity="center_vertical"
                        android:background="@drawable/ic_snapping_nav"
                        android:layout_width="@dimen/navigation_icon_dimen"
                        android:layout_height="@dimen/navigation_icon_dimen"/>
                    <TextView
                        android:layout_gravity="center_vertical"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/snapping"
                        android:layout_marginStart="24dp"
                        style="@style/RecentsNavItemsTextStyle"/>
                </LinearLayout>
                <LinearLayout
                    android:layout_gravity="end"
                    android:orientation="horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="10sp"
                        android:layout_gravity="center_vertical"
                        android:id="@+id/snapping_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/on"
                        android:fontFamily="sans-serif-medium"
                        android:layout_marginEnd="4dp"
                        style="@style/VerySmallDarkText"/>
                    <Switch
                        android:layout_gravity="end"
                        android:id="@+id/snap_switch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </LinearLayout>
            </FrameLayout>
            <FrameLayout
                android:id="@+id/vibration"
                android:padding="12dp"
                android:clickable="true"
                android:clipChildren="true"
                android:clipToPadding="true"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:foreground="@drawable/ripple">
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="12dp">
                    <View
                        android:layout_gravity="center_vertical"
                        android:background="@drawable/ic_vibrate_on_conneect"
                        android:layout_width="@dimen/navigation_icon_dimen"
                        android:layout_height="@dimen/navigation_icon_dimen"/>
                    <TextView
                        android:layout_gravity="center_vertical"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/vibration"
                        android:layout_marginStart="24dp"
                        style="@style/RecentsNavItemsTextStyle"/>
                </LinearLayout>
                <LinearLayout
                    android:layout_gravity="end"
                    android:orientation="horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="10sp"
                        android:layout_gravity="center_vertical"
                        android:id="@+id/vibration_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/on"
                        android:fontFamily="sans-serif-medium"
                        android:layout_marginEnd="4dp"
                        style="@style/VerySmallDarkText"/>
                    <Switch
                        android:layout_gravity="end"
                        android:id="@+id/vibration_switch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </LinearLayout>
            </FrameLayout>
            <FrameLayout
                android:id="@+id/show_labels_menu"
                android:padding="12dp"
                android:clickable="true"
                android:clipChildren="true"
                android:clipToPadding="true"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:foreground="@drawable/ripple">
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="12dp">
                    <View
                        android:layout_gravity="center_vertical"
                        android:background="@drawable/ic_label_nav"
                        android:layout_width="@dimen/navigation_icon_dimen"
                        android:layout_height="@dimen/navigation_icon_dimen"/>
                    <TextView
                        android:layout_gravity="center_vertical"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/labels_visibility"
                        android:layout_marginStart="24dp"
                        style="@style/RecentsNavItemsTextStyle"/>
                </LinearLayout>
                <LinearLayout
                    android:layout_gravity="end"
                    android:orientation="horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="10sp"
                        android:layout_gravity="center_vertical"
                        android:id="@+id/labels_visibility_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/on"
                        android:fontFamily="sans-serif-medium"
                        android:layout_marginEnd="4dp"
                        style="@style/VerySmallDarkText"/>
                    <Switch
                        android:layout_gravity="end"
                        android:id="@+id/labels_visibility_switch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </LinearLayout>
            </FrameLayout>
            <FrameLayout
                android:id="@+id/drawer_help"
                android:padding="12dp"
                android:clipChildren="true"
                android:clipToPadding="true"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:foreground="@drawable/ripple">
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="12dp">
                    <View
                        android:layout_gravity="center_vertical"
                        android:background="@drawable/ic_about_nav"
                        android:layout_width="@dimen/navigation_icon_dimen"
