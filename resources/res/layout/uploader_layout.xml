<?xml version="1.0" encoding="utf-8"?>
<com.duracodefactory.logiccircuitsimulatorpro.ui.UploaderLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/upload_layout"
    android:background="@color/recents_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="horizontal"
        android:background="@color/recents_bg"
        android:paddingBottom="4dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <FrameLayout
            android:layout_gravity="center_vertical"
            android:id="@+id/back_arrow"
            android:padding="16dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:foreground="@drawable/ripple">
            <View
                android:layout_gravity="center_vertical"
                android:background="@drawable/ic_left_arrow_dark"
                android:layout_width="@dimen/toolbar_back_dimen"
                android:layout_height="@dimen/toolbar_back_dimen"/>
        </FrameLayout>
        <TextView
            android:textSize="18sp"
            android:layout_gravity="center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/upload_project"
            android:fontFamily="sans-serif-medium"
            android:layout_marginStart="16dp"
            style="@style/BigDarkText"/>
    </LinearLayout>
    <View
        android:background="@color/separator_light"
        android:layout_width="match_parent"
        android:layout_height="1dp"/>
    <FrameLayout
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:paddingStart="24dp"
        android:paddingEnd="24dp">
        <com.duracodefactory.logiccircuitsimulatorpro.ui.RecentsRecyclerView
            android:id="@+id/upload_recycler"
            android:paddingTop="24dp"
            android:paddingBottom="24dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:overScrollMode="never"/>
        <FrameLayout
            android:layout_gravity="center"
            android:id="@+id/share_project_loading"
            android:background="@drawable/recents_loading_bg"
            android:padding="12dp"
            android:visibility="gone"
            android:layout_width="@dimen/recent_projects_loading_size"
            android:layout_height="@dimen/recent_projects_loading_size">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <ProgressBar
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:indeterminateTint="@color/light"/>
                <TextView
                    android:textStyle="bold"
                    android:textColor="@color/light_on_accent"
                    android:ellipsize="marquee"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/loading"
                    android:singleLine="true"
                    android:textAlignment="center"
                    style="@style/MediumLightText"/>
            </LinearLayout>
        </FrameLayout>
        <FrameLayout
            android:layout_gravity="center"
            android:id="@+id/share_project_empty"
            android:background="@drawable/rounded_no_outline_bg_accent"
            android:padding="12dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp">
            <TextView
                android:textColor="@color/light_on_accent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/you_don_t_have_any_projects"
                android:textAlignment="center"
                style="@style/MediumDarkText"/>
        </FrameLayout>
    </FrameLayout>
</com.duracodefactory.logiccircuitsimulatorpro.ui.UploaderLayout>
