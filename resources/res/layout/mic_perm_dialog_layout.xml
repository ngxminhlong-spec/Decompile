<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:elevation="4dp"
    app:cardCornerRadius="4dp">
    <LinearLayout
        android:orientation="vertical"
        android:paddingTop="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="24dp"
        android:paddingEnd="24dp">
        <TextView
            android:textStyle="bold"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/mic_permission"
            android:textAllCaps="true"
            android:fontFamily="sans-serif-condensed"
            style="@style/BigDarkText"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/mic_permission_explanation"
            style="@style/MediumDarkText"/>
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp">
            <Button
                android:layout_gravity="end|bottom"
                android:id="@+id/permissions_dlg_allow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/allow_permission"
                style="@style/Widget.MaterialComponents.Button.TextButton.Dialog"/>
            <Button
                android:layout_gravity="start|bottom"
                android:id="@+id/permissions_dlg_close"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/deny"
                style="@style/Widget.MaterialComponents.Button.TextButton.Dialog"/>
        </FrameLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
