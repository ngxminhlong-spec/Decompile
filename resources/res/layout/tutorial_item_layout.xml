<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@drawable/rounded_bg_selectable"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="4dp"
    android:layout_marginBottom="4dp"
    android:layout_marginStart="16dp"
    android:layout_marginEnd="16dp">
    <LinearLayout
        android:orientation="horizontal"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="8dp">
            <TextView
                android:textSize="14sp"
                android:textStyle="bold"
                android:ellipsize="end"
                android:id="@+id/tut_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="2"
                android:fontFamily="sans-serif-condensed"
                android:textAlignment="viewStart"
                android:layout_marginStart="8dp"
                style="@style/BigDarkText"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/dark_secondary_text"
                android:ellipsize="end"
                android:id="@+id/tut_descr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="2"
                android:fontFamily="sans-serif-condensed"
                android:textAlignment="viewStart"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                style="@style/SmallDarkText"/>
        </LinearLayout>
        <FrameLayout
            android:layout_gravity="center_vertical"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="56dp"
            android:layout_height="56dp">
            <FrameLayout
                android:background="@drawable/avatar_shadow"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:elevation="2dp"/>
            <ImageView
                android:id="@+id/tut_drawable"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:scaleType="fitCenter"
                android:elevation="3dp"/>
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
