<?xml version="1.0" encoding="utf-8"?>
<com.duracodefactory.logiccircuitsimulatorpro.ui.StartupScreen xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/welcome_screen_startup"
    android:background="#ffffff"
    android:paddingTop="16dp"
    android:paddingBottom="16dp"
    android:focusable="true"
    android:clickable="true"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="16dp"
    android:paddingEnd="16dp">
    <LinearLayout
        android:orientation="vertical"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <FrameLayout
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="@dimen/welcome_text_space">
            <TextView
                android:textSize="32sp"
                android:textColor="#403c3c"
                android:layout_gravity="center"
                android:id="@+id/welcome_item_title"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/welcome"
                android:fontFamily="sans-serif-condensed-light"/>
        </FrameLayout>
        <FrameLayout
            android:layout_gravity="center_horizontal"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="@dimen/welcome_image_size"
            android:layout_height="0dp"
            android:layout_weight="1">
            <LinearLayout
                android:layout_gravity="center"
                android:orientation="vertical"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <FrameLayout
                    android:id="@+id/welcome_card_container"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/welcome_card_height"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/welcome_links_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:alpha="0">
                    <FrameLayout
                        android:layout_gravity="center_horizontal"
                        android:id="@+id/terms_link"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp">
                        <TextView
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="?attr/colorAccent"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/terms_and_conditions"
                            android:textAllCaps="true"
                            android:fontFamily="sans-serif-condensed"
                            android:textAlignment="center"/>
                    </FrameLayout>
                    <FrameLayout
                        android:layout_gravity="center_horizontal"
                        android:id="@+id/privacy_policy_link"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp">
                        <TextView
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="?attr/colorAccent"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/privacy_policy"
                            android:textAllCaps="true"
                            android:fontFamily="sans-serif-condensed"
                            android:textAlignment="center"/>
                    </FrameLayout>
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>
        <FrameLayout
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.google.android.material.button.MaterialButton
                android:layout_gravity="start|bottom"
                android:id="@+id/welcome_prev_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/back"
                android:alpha="0"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>
            <com.google.android.material.button.MaterialButton
                android:textColor="#ffffff"
                android:layout_gravity="end|bottom"
                android:id="@+id/welcome_next_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/continue_text"
                style="@style/Widget.MaterialComponents.Button"/>
        </FrameLayout>
    </LinearLayout>
</com.duracodefactory.logiccircuitsimulatorpro.ui.StartupScreen>
