<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/popup_bg"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:foreground="@drawable/rounded_outline_bg"
    app:cardCornerRadius="4dp">
    <LinearLayout
        android:orientation="horizontal"
        android:background="@color/recents_bg"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="4dp"
        android:paddingStart="16dp"
        android:paddingEnd="4dp">
        <FrameLayout
            android:layout_gravity="center_vertical"
            android:padding="6dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/ic_image"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_ic_new_for_recents"
                android:scaleType="centerCrop"
                android:tint="?attr/colorAccent"/>
            <LinearLayout
                android:orientation="horizontal"
                android:paddingTop="4dp"
                android:paddingBottom="8dp"
                android:visibility="gone"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="4dp"
                android:paddingEnd="8dp">
                <FrameLayout
                    android:id="@+id/recents_item_available_io"
                    android:visibility="gone"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginEnd="4dp"
                    android:elevation="1dp">
                    <TextView
                        android:textSize="9dp"
                        android:textColor="@color/light_on_accent"
                        android:layout_gravity="center"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="IO"
                        style="@style/VerySmallDarkText"/>
                </FrameLayout>
                <FrameLayout
                    android:id="@+id/recent_item_has_timediagrams"
                    android:background="@drawable/button_accent_bg_4dp"
                    android:padding="4dp"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:elevation="1dp">
                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/ic_time_diagrma_white"/>
                </FrameLayout>
            </LinearLayout>
        </FrameLayout>
        <LinearLayout
            android:orientation="vertical"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingStart="16dp"
            android:paddingEnd="4dp">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/dark_text"
                    android:ellipsize="marquee"
                    android:layout_gravity="start|center_vertical"
                    android:id="@+id/project_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:includeFontPadding="false"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-medium"
                    android:textAlignment="viewStart"/>
                <FrameLayout
                    android:layout_gravity="center_vertical"
                    android:id="@+id/project_delete"
                    android:padding="11dp"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:foreground="@drawable/ripple">
                    <View
                        android:background="@drawable/ic_trash"
                        android:layout_width="16dp"
                        android:layout_height="16dp"/>
                </FrameLayout>
            </LinearLayout>
            <LinearLayout
                android:gravity="start|center_vertical"
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:paddingEnd="12dp">
                <View
                    android:background="@drawable/ic_projects_recents_item"
                    android:layout_width="@dimen/recent_project_mini_icons_size"
                    android:layout_height="@dimen/recent_project_mini_icons_size"/>
                <TextView
                    android:textSize="11sp"
                    android:textColor="@color/dark_secondary_text_recent"
                    android:ellipsize="marquee"
                    android:id="@+id/elem_num"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-condensed"
                    android:paddingStart="8dp"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="start|center_vertical"
                android:orientation="horizontal"
                android:paddingTop="2dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingEnd="12dp">
                <View
                    android:background="@drawable/ic_connect_control_item"
                    android:layout_width="@dimen/recent_project_mini_icons_size"
                    android:layout_height="@dimen/recent_project_mini_icons_size"/>
                <TextView
                    android:textSize="11sp"
                    android:textColor="@color/dark_secondary_text_recent"
                    android:ellipsize="marquee"
                    android:id="@+id/conn_num"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-condensed"
                    android:paddingStart="8dp"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="bottom"
                android:orientation="horizontal"
                android:paddingTop="8dp"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingEnd="12dp">
                <LinearLayout
                    android:gravity="start|center_vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <View
                        android:background="@drawable/ic_date_modified"
                        android:layout_width="@dimen/recent_project_mini_icons_size"
                        android:layout_height="@dimen/recent_project_mini_icons_size"/>
                    <TextView
                        android:ellipsize="marquee"
                        android:gravity="bottom"
                        android:id="@+id/date_modified"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingStart="4dp"
                        style="@style/VerySmallDarkText"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:layout_gravity="end|center_vertical"
        android:orientation="vertical"
        android:id="@+id/upload_button"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="12dp"
        android:paddingEnd="24dp">
        <ImageView
            android:layout_gravity="center"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_upload_project_icon"
            android:tint="?attr/colorAccent"/>
    </LinearLayout>
</FrameLayout>
