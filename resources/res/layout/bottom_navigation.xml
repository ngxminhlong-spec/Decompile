<?xml version="1.0" encoding="utf-8"?>
<com.duracodefactory.logiccircuitsimulatorpro.ui.BottomNavigationBarView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/recents_bg"
    android:layout_width="match_parent"
    android:layout_height="@dimen/bottom_bar_height"
    android:elevation="8dp"
    app:disabledColor="@color/dark_secondary_text"
    app:enabledColor="?attr/colorAccent">
    <FrameLayout
        android:clipChildren="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:layout_gravity="center_horizontal"
            android:orientation="horizontal"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="wrap_content"
            android:layout_height="match_parent">
            <FrameLayout
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_width="@dimen/bottombar_item_min_width"
                android:layout_height="match_parent">
                <FrameLayout
                    android:layout_gravity="center"
                    android:id="@+id/projects_tab"
                    android:clickable="true"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:foreground="@drawable/ripple">
                    <LinearLayout
                        android:layout_gravity="center"
                        android:orientation="vertical"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">
                        <ImageView
                            android:layout_gravity="center_horizontal"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_projects_recents"/>
                        <TextView
                            android:textSize="12sp"
                            android:textColor="@color/dark_text"
                            android:ellipsize="marquee"
                            android:layout_gravity="center_horizontal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/projects"
                            android:singleLine="true"
                            android:fontFamily="sans-serif"/>
                    </LinearLayout>
                </FrameLayout>
            </FrameLayout>
            <FrameLayout
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_width="@dimen/bottombar_item_min_width"
                android:layout_height="match_parent">
                <FrameLayout
                    android:layout_gravity="center"
                    android:id="@+id/tutorials_tab"
                    android:clickable="true"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:foreground="@drawable/ripple">
                    <LinearLayout
                        android:layout_gravity="center"
                        android:orientation="vertical"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">
                        <ImageView
                            android:layout_gravity="center_horizontal"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_tutorials_recents"/>
                        <TextView
                            android:textSize="12sp"
                            android:textColor="@color/dark_text"
                            android:ellipsize="marquee"
                            android:layout_gravity="center_horizontal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/tutorials"
                            android:singleLine="true"
                            android:fontFamily="sans-serif"/>
                    </LinearLayout>
                </FrameLayout>
            </FrameLayout>
            <FrameLayout
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_width="@dimen/bottombar_item_min_width"
                android:layout_height="match_parent">
                <FrameLayout
                    android:layout_gravity="center"
                    android:id="@+id/learning_tab"
                    android:clickable="true"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:foreground="@drawable/ripple">
                    <LinearLayout
                        android:layout_gravity="center"
                        android:orientation="vertical"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">
                        <ImageView
                            android:layout_gravity="center_horizontal"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_learn_recents"/>
                        <TextView
                            android:textSize="12sp"
                            android:textColor="@color/dark_text"
                            android:ellipsize="marquee"
                            android:layout_gravity="center_horizontal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/learn"
                            android:singleLine="true"
                            android:fontFamily="sans-serif"/>
                    </LinearLayout>
                </FrameLayout>
            </FrameLayout>
            <FrameLayout
                android:id="@+id/sharing_bottom_button"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_width="@dimen/bottombar_item_min_width"
                android:layout_height="match_parent">
                <FrameLayout
                    android:layout_gravity="center"
                    android:id="@+id/shared_tab"
                    android:clickable="true"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:foreground="@drawable/ripple">
                    <LinearLayout
                        android:layout_gravity="center"
                        android:orientation="vertical"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">
                        <ImageView
                            android:layout_gravity="center_horizontal"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_share_icon"/>
                        <TextView
                            android:textSize="12sp"
                            android:textColor="@color/dark_text"
                            android:ellipsize="marquee"
                            android:layout_gravity="center_horizontal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/shared_projects"
                            android:singleLine="true"
                            android:fontFamily="sans-serif"/>
                    </LinearLayout>
                    <FrameLayout
                        android:layout_gravity="end"
                        android:id="@+id/shared_new_label"
                        android:background="@drawable/rounded_no_outline_bg_red_new"
                        android:paddingTop="2dp"
                        android:paddingBottom="2dp"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp"
                        android:layout_marginEnd="2dp">
                        <TextView
                            android:textSize="10dp"
                            android:textColor="@color/light_on_accent"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/new_t"/>
                    </FrameLayout>
                </FrameLayout>
            </FrameLayout>
        </LinearLayout>
    </FrameLayout>
</com.duracodefactory.logiccircuitsimulatorpro.ui.BottomNavigationBarView>
