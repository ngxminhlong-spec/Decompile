<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:foreground="@drawable/ripple">
    <FrameLayout
        android:id="@+id/background_select"
        android:background="@drawable/controls_selected_bg"
        android:layout_width="@dimen/controls_small_notext_size"
        android:layout_height="@dimen/controls_small_notext_size"/>
    <FrameLayout
        android:padding="@dimen/controls_padding_notext"
        android:layout_width="@dimen/controls_small_notext_size"
        android:layout_height="@dimen/controls_small_notext_size">
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <View
                android:id="@+id/icon"
                android:layout_width="@dimen/controls_icon_small_notext_size"
                android:layout_height="@dimen/controls_icon_small_notext_size"/>
            <TextView
                android:ellipsize="marquee"
                android:gravity="bottom"
                android:id="@+id/text"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:singleLine="true"
                android:layout_weight="1"/>
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
