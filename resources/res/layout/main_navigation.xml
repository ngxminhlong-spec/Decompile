<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/recents_bg"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ScrollView
        android:background="@color/recents_bg"
        android:paddingBottom="48dp"
        android:scrollbars="none"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="vertical"
            android:background="@color/recents_bg"
            android:paddingTop="24dp"
            android:clipChildren="true"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <FrameLayout
                android:background="@color/recents_bg"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="@dimen/header_toolbar_height">
                <RelativeLayout
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <LinearLayout
                        android:orientation="horizontal"
                        android:id="@+id/drawer_profile_info"
                        android:paddingTop="12dp"
                        android:paddingBottom="12dp"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_toStartOf="@+id/edit_profile"
                        android:layout_alignParentStart="true">
                        <FrameLayout
                            android:layout_gravity="center_vertical"
                            android:id="@+id/avatar_frame"
                            android:focusable="true"
                            android:clickable="true"
                            android:clipChildren="false"
                            android:clipToPadding="false"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:foreground="@drawable/ripple"
                            android:layout_marginStart="24dp">
                            <View
                                android:layout_gravity="center"
                                android:background="@drawable/avatar_shadow_new"
                                android:layout_width="@dimen/avatar_bg_size"
                                android:layout_height="@dimen/avatar_bg_size"/>
                            <com.duracodefactory.logiccircuitsimulatorpro.ui.AvatarView
                                android:layout_gravity="center"
                                android:id="@+id/avatar"
                                android:layout_width="@dimen/avatar_size"
                                android:layout_height="@dimen/avatar_size"
                                android:scaleType="fitCenter"
                                android:elevation="@dimen/avatar_elevation"/>
                        </FrameLayout>
                        <LinearLayout
                            android:layout_gravity="center_vertical"
                            android:orientation="vertical"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="24dp">
                            <TextView
                                android:textStyle="bold"
                                android:ellipsize="marquee"
                                android:layout_gravity="center_vertical"
                                android:id="@+id/profile_name"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:singleLine="true"
                                android:fontFamily="sans-serif-condensed"
                                style="@style/BigDarkText"/>
                            <TextView
                                android:textSize="10sp"
                                android:textStyle="bold"
                                android:ellipsize="marquee"
                                android:layout_gravity="center_vertical"
                                android:id="@+id/projects_count"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:singleLine="true"
                                android:textAllCaps="true"
                                android:fontFamily="sans-serif-condensed"
                                style="@style/SmallerDarkText"/>
                        </LinearLayout>
                    </LinearLayout>
                    <FrameLayout
                        android:id="@+id/edit_profile"
                        android:padding="16dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:foreground="@drawable/ripple"
                        android:layout_centerVertical="true"
                        android:layout_alignParentEnd="true">
                        <View
                            android:background="@drawable/ic_profile_setting"
                            android:layout_width="18dp"
                            android:layout_height="18dp"/>
                    </FrameLayout>
                </RelativeLayout>
            </FrameLayout>
            <View
                android:background="@color/separator_light"
                android:layout_width="match_parent"
                android:layout_height="2dp"/>
            <FrameLayout
                android:id="@+id/drawer_go_premium"
                android:padding="12dp"
                android:clipChildren="true"
                android:clipToPadding="true"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:foreground="@drawable/ripple">
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="4dp">
                    <View
                        android:layout_gravity="center_vertical"
                        android:background="@drawable/ic_pro_nav"
                        android:layout_width="@dimen/navigation_icon_dimen"
                        android:layout_height="@dimen/navigation_icon_dimen"/>
                    <TextView
                        android:layout_gravity="center_vertical"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/unlock_full_version"
                        android:layout_marginStart="36dp"
                        style="@style/RecentsNavItemsTextStyle"/>
                </LinearLayout>
            </FrameLayout>
            <FrameLayout
                android:id="@+id/electro"
                android:padding="12dp"
                android:clipChildren="true"
                android:clipToPadding="true"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:foreground="@drawable/ripple">
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="4dp">
                    <View
                        android:layout_gravity="center_vertical"
                        android:background="@drawable/ic_calcs_icon"
                        android:layout_width="@dimen/navigation_icon_dimen"
                        android:layout_height="@dimen/navigation_icon_dimen"/>
                    <TextView
                        android:layout_gravity="center_vertical"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ElectroBox"
                        android:layout_marginStart="36dp"
                        style="@style/RecentsNavItemsTextStyle"/>
                </LinearLayout>
            </FrameLayout>
            <FrameLayout
                android:id="@+id/drawer_go_premium_old_user"
                android:padding="12dp"
                android:clipChildren="true"
                android:clipToPadding="true"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:foreground="@drawable/ripple">
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="4dp">
                    <View
                        android:layout_gravity="center_vertical"
                        android:background="@drawable/ic_support_us_buy"
                        android:layout_width="@dimen/navigation_icon_dimen"
                        android:layout_height="@dimen/navigation_icon_dimen"/>
                    <TextView
                        android:layout_gravity="center_vertical"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/support_us"
                        android:layout_marginStart="36dp"
                        style="@style/RecentsNavItemsTextStyle"/>
                </LinearLayout>
            </FrameLayout>
            <FrameLayout
                android:id="@+id/drawer_import_project"
                android:padding="12dp"
                android:clipChildren="true"
                android:clipToPadding="true"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:foreground="@drawable/ripple">
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="4dp">
                    <View
                        android:layout_gravity="center_vertical"
                        android:background="@drawable/ic_import_navs"
                        android:layout_width="@dimen/navigation_icon_dimen"
                        android:layout_height="@dimen/navigation_icon_dimen"/>
                    <TextView
                        android:layout_gravity="center_vertical"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/import_project"
                        android:layout_marginStart="36dp"
                        style="@style/RecentsNavItemsTextStyle"/>
                </LinearLayout>
            </FrameLayout>
            <FrameLayout
                android:id="@+id/drawer_tutorials"
                android:padding="12dp"
                android:clipChildren="true"
                android:clipToPadding="true"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:foreground="@drawable/ripple">
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="4dp">
                    <View
                        android:layout_gravity="center_vertical"
                        android:background="@drawable/ic_tutorials_recents_nav"
                        android:layout_width="@dimen/navigation_icon_dimen"
                        android:layout_height="@dimen/navigation_icon_dimen"/>
                    <TextView
                        android:layout_gravity="center_vertical"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/tutorials"
                        android:layout_marginStart="36dp"
                        style="@style/RecentsNavItemsTextStyle"/>
                </LinearLayout>
            </FrameLayout>
            <FrameLayout
                android:id="@+id/drawer_theme"
                android:padding="12dp"
                android:clipChildren="true"
                android:clipToPadding="true"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:foreground="@drawable/ripple">
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="4dp">
                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">
                        <View
                            android:layout_gravity="center_vertical"
                            android:background="@drawable/ic_themes_nav"
                            android:layout_width="@dimen/navigation_icon_dimen"
                            android:layout_height="@dimen/navigation_icon_dimen"/>
                        <TextView
                            android:layout_gravity="center_vertical"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/theme"
                            android:layout_marginStart="36dp"
                            style="@style/RecentsNavItemsTextStyle"/>
                    </LinearLayout>
                    <LinearLayout
                        android:orientation="vertical"
                        android:paddingTop="4dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingStart="54dp">
                        <LinearLayout
                            android:orientation="horizontal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content">
                            <FrameLayout
                                android:id="@+id/theme1_container"
                                android:padding="@dimen/theme_selector_padding"
                                android:clipChildren="false"
                                android:clipToPadding="false"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content">
                                <FrameLayout
                                    android:id="@+id/theme1"
                                    android:background="@drawable/theme1_selector"
                                    android:layout_width="@dimen/theme_selector_size"
                                    android:layout_height="@dimen/theme_selector_size"
                                    android:elevation="@dimen/theme_circles_elevation"/>
                            </FrameLayout>
                            <FrameLayout
                                android:id="@+id/theme2_container"
                                android:padding="@dimen/theme_selector_padding"
                                android:clipChildren="false"
                                android:clipToPadding="false"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content">
                                <FrameLayout
                                    android:id="@+id/theme2"
                                    android:background="@drawable/theme2_selector"
                                    android:layout_width="@dimen/theme_selector_size"
                                    android:layout_height="@dimen/theme_selector_size"
                                    android:elevation="@dimen/theme_circles_elevation"/>
                            </FrameLayout>
                            <FrameLayout
                                android:id="@+id/theme3_container"
                                android:padding="@dimen/theme_selector_padding"
                                android:clipChildren="false"
                                android:clipToPadding="false"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content">
                                <FrameLayout
                                    android:id="@+id/theme3"
                                    android:background="@drawable/theme3_selector"
                                    android:layout_width="@dimen/theme_selector_size"
                                    android:layout_height="@dimen/theme_selector_size"
                                    android:elevation="@dimen/theme_circles_elevation"/>
                            </FrameLayout>
                            <FrameLayout
                                android:id="@+id/theme8_container"
                                android:padding="@dimen/theme_selector_padding"
                                android:clipChildren="false"
                                android:clipToPadding="false"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content">
                                <FrameLayout
                                    android:id="@+id/theme8"
                                    android:background="@drawable/theme8_selector"
                                    android:layout_width="@dimen/theme_selector_size"
                                    android:layout_height="@dimen/theme_selector_size"
                                    android:elevation="@dimen/theme_circles_elevation"/>
                            </FrameLayout>
                        </LinearLayout>
                        <LinearLayout
                            android:orientation="horizontal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content">
                            <FrameLayout
                                android:id="@+id/theme7_container"
                                android:padding="@dimen/theme_selector_padding"
                                android:clipChildren="false"
                                android:clipToPadding="false"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content">
                                <FrameLayout
                                    android:id="@+id/theme7"
                                    android:background="@drawable/theme7_selector"
                                    android:layout_width="@dimen/theme_selector_size"
                                    android:layout_height="@dimen/theme_selector_size"
                                    android:elevation="@dimen/theme_circles_elevation"/>
                            </FrameLayout>
                            <FrameLayout
                                android:id="@+id/theme4_container"
                                android:padding="@dimen/theme_selector_padding"
                                android:clipChildren="false"
                                android:clipToPadding="false"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content">
                                <FrameLayout
                                    android:id="@+id/theme4"
                                    android:background="@drawable/theme4_selector"
                                    android:layout_width="@dimen/theme_selector_size"
                                    android:layout_height="@dimen/theme_selector_size"
                                    android:elevation="@dimen/theme_circles_elevation"/>
                            </FrameLayout>
                            <FrameLayout
                                android:id="@+id/theme5_container"
                                android:padding="@dimen/theme_selector_padding"
                                android:clipChildren="false"
                                android:clipToPadding="false"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content">
                                <FrameLayout
                                    android:id="@+id/theme5"
                                    android:background="@drawable/theme5_selector"
                                    android:layout_width="@dimen/theme_selector_size"
                                    android:layout_height="@dimen/theme_selector_size"
                                    android:elevation="@dimen/theme_circles_elevation"/>
                            </FrameLayout>
                            <FrameLayout
                                android:id="@+id/theme6_container"
                                android:padding="@dimen/theme_selector_padding"
                                android:clipChildren="false"
                                android:clipToPadding="false"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content">
                                <FrameLayout
                                    android:id="@+id/theme6"
                                    android:background="@drawable/theme6_selector"
                                    android:layout_width="@dimen/theme_selector_size"
                                    android:layout_height="@dimen/theme_selector_size"
                                    android:elevation="@dimen/theme_circles_elevation"/>
                            </FrameLayout>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </FrameLayout>
            <FrameLayout
                android:id="@+id/drawer_dark_mode"
                android:padding="12dp"
                android:clickable="true"
                android:clipChildren="true"
                android:clipToPadding="true"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:foreground="@drawable/ripple">
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="4dp">
                    <View
                        android:layout_gravity="center_vertical"
                        android:background="@drawable/ic_dark_mode_nav"
                        android:layout_width="@dimen/navigation_icon_dimen"
                        android:layout_height="@dimen/navigation_icon_dimen"/>
                    <TextView
                        android:layout_gravity="center_vertical"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/dark_mode"
                        android:layout_marginStart="36dp"
                        style="@style/RecentsNavItemsTextStyle"/>
                </LinearLayout>
                <LinearLayout
                    android:layout_gravity="end"
                    android:orientation="horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="10sp"
                        android:layout_gravity="center_vertical"
                        android:id="@+id/dark_mode_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/on"
                        android:layout_marginEnd="4dp"
                        style="@style/VerySmallDarkText"/>
                    <Switch
                        android:layout_gravity="end"
                        android:id="@+id/dark_mode_swtich"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </LinearLayout>
            </FrameLayout>
            <FrameLayout
                android:id="@+id/drawer_help"
                android:padding="12dp"
                android:clipChildren="true"
                android:clipToPadding="true"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:foreground="@drawable/ripple">
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="4dp">
                    <View
                        android:layout_gravity="center_vertical"
                        android:background="@drawable/ic_about_nav"
                        android:layout_width="@dimen/navigation_icon_dimen"
                        android:layout_height="@dimen/navigation_icon_dimen"/>
                    <TextView
                        android:layout_gravity="center_vertical"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/about"
                        android:layout_marginStart="36dp"
                        style="@style/RecentsNavItemsTextStyle"/>
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
