<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/rounded_outline_bg_with_bg_shared"
    android:paddingTop="4dp"
    android:paddingBottom="4dp"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:paddingStart="16dp"
    android:paddingEnd="4dp">
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="horizontal"
                android:background="@color/recents_bg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="4dp">
                <LinearLayout
                    android:layout_gravity="center_vertical"
                    android:orientation="vertical"
                    android:id="@+id/download_button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <ImageView
                        android:layout_gravity="center_horizontal"
                        android:id="@+id/ic_image"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:src="@drawable/chip_illustration"
                        android:adjustViewBounds="true"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:paddingStart="16dp"
                    android:paddingEnd="4dp">
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <TextView
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="@color/dark_text"
                            android:ellipsize="marquee"
                            android:layout_gravity="start|center_vertical"
                            android:id="@+id/share_item_standard_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:singleLine="true"
                            android:includeFontPadding="false"
                            android:layout_weight="1"
                            android:fontFamily="sans-serif-medium"
                            android:textAlignment="viewStart"/>
                        <FrameLayout
                            android:layout_gravity="center_vertical"
                            android:id="@+id/project_delete"
                            android:padding="11dp"
                            android:visibility="gone"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:foreground="@drawable/ripple">
                            <View
                                android:background="@drawable/ic_trash"
                                android:layout_width="16dp"
                                android:layout_height="16dp"/>
                        </FrameLayout>
                    </LinearLayout>
                    <LinearLayout
                        android:gravity="start|center_vertical"
                        android:orientation="horizontal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:paddingEnd="12dp">
                        <View
                            android:background="@drawable/ic_projects_recents_item"
                            android:layout_width="@dimen/recent_project_mini_icons_size"
                            android:layout_height="@dimen/recent_project_mini_icons_size"/>
                        <TextView
                            android:textSize="11sp"
                            android:textColor="@color/dark_secondary_text_recent"
                            android:ellipsize="marquee"
                            android:id="@+id/elem_num"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-condensed"
                            android:paddingStart="8dp"/>
                    </LinearLayout>
                    <LinearLayout
                        android:gravity="start|center_vertical"
                        android:orientation="horizontal"
                        android:paddingTop="2dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingEnd="12dp">
                        <View
                            android:background="@drawable/ic_connect_control_item"
                            android:layout_width="@dimen/recent_project_mini_icons_size"
                            android:layout_height="@dimen/recent_project_mini_icons_size"/>
                        <TextView
                            android:textSize="11sp"
                            android:textColor="@color/dark_secondary_text_recent"
                            android:ellipsize="marquee"
                            android:id="@+id/conn_num"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-condensed"
                            android:paddingStart="8dp"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginStart="40dp">
                <LinearLayout
                    android:paddingBottom="12dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <ImageView
                        android:layout_gravity="center_vertical"
                        android:id="@+id/download_ok"
                        android:layout_width="wrap_content"
                        android:layout_height="14dp"
                        android:src="@drawable/ic_downloadsnum"
                        android:layout_marginStart="12dp"/>
                    <ImageView
                        android:layout_gravity="center_vertical"
                        android:id="@+id/download_non"
                        android:layout_width="wrap_content"
                        android:layout_height="14dp"
                        android:src="@drawable/ic_downloadsnum_non"
                        android:layout_marginStart="12dp"/>
                    <TextView
                        android:textSize="11dp"
                        android:textColor="@color/dark_text"
                        android:layout_gravity="center_vertical"
                        android:id="@+id/share_item_standard_downloads"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="500"
                        android:fontFamily="sans-serif-medium"
                        android:layout_marginStart="2dp"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="horizontal"
                    android:id="@+id/like_button"
                    android:paddingBottom="12dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingEnd="12dp">
                    <ImageView
                        android:layout_gravity="center_vertical"
                        android:id="@+id/shared_like_image"
                        android:layout_width="wrap_content"
                        android:layout_height="14dp"
                        android:src="@drawable/ic_like"
                        android:layout_marginStart="12dp"/>
                    <ImageView
                        android:layout_gravity="center_vertical"
                        android:id="@+id/shared_non_like_image"
                        android:layout_width="wrap_content"
                        android:layout_height="14dp"
                        android:src="@drawable/ic_like_non"
                        android:layout_marginStart="12dp"/>
                    <TextView
                        android:textSize="11dp"
                        android:textColor="@color/dark_text"
                        android:layout_gravity="center_vertical"
                        android:id="@+id/share_item_standard_likes"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="122"
                        android:fontFamily="sans-serif-medium"
                        android:layout_marginStart="2dp"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
        <FrameLayout
            android:layout_gravity="end|bottom"
            android:id="@+id/shared_item_explore"
            android:background="@drawable/rounded_no_outline_bg_accent_shared"
            android:padding="12dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:alpha="0.75"
            android:layout_marginEnd="12dp"
            android:elevation="4dp">
            <ImageView
                android:layout_gravity="center"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:src="@drawable/ic_arrow_themed"
                android:rotation="180"/>
        </FrameLayout>
        <FrameLayout
            android:layout_gravity="end|bottom"
            android:id="@+id/shared_item_explore_selected"
            android:background="@drawable/rounded_no_outline_bg_accent_shared"
            android:padding="12dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:layout_marginEnd="12dp"
            android:elevation="4dp">
            <ImageView
                android:layout_gravity="center"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_arrow_themed"
                android:rotation="180"/>
        </FrameLayout>
    </FrameLayout>
</LinearLayout>
