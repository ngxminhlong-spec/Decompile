<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_gravity="bottom|center_horizontal"
    android:orientation="vertical"
    android:background="@color/recents_bg"
    android:paddingTop="12dp"
    android:paddingBottom="36dp"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="480dp"
    android:layout_height="wrap_content"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:elevation="12dp">
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:layout_gravity="center_vertical"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_logo_icon"/>
        <TextView
            android:textSize="16dp"
            android:textColor="@color/dark_text"
            android:layout_gravity="center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:fontFamily="sans-serif"
            android:layout_marginStart="12dp"/>
    </LinearLayout>
    <View
        android:background="@color/separator_light"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="12dp"/>
    <TextView
        android:textSize="14dp"
        android:textColor="@color/dark_secondary_text"
        android:layout_gravity="center_vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/rate_5_stars_button"
        android:fontFamily="sans-serif"/>
    <LinearLayout
        android:layout_gravity="center"
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp">
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/rate_us_1_stars"
            android:layout_width="@dimen/rate_us_star_width"
            android:layout_height="@dimen/rate_us_star_height"
            android:src="@drawable/ic_star_rate_us"/>
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/rate_us_2_stars"
            android:layout_width="@dimen/rate_us_star_width"
            android:layout_height="@dimen/rate_us_star_height"
            android:src="@drawable/ic_star_rate_us"
            android:layout_marginStart="12dp"/>
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/rate_us_3_stars"
            android:layout_width="@dimen/rate_us_star_width"
            android:layout_height="@dimen/rate_us_star_height"
            android:src="@drawable/ic_star_rate_us"
            android:layout_marginStart="12dp"/>
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/rate_us_4_stars"
            android:layout_width="@dimen/rate_us_star_width"
            android:layout_height="@dimen/rate_us_star_height"
            android:src="@drawable/ic_star_rate_us"
            android:layout_marginStart="12dp"/>
        <ImageView
            android:id="@+id/rate_us_five_stars"
            android:layout_width="@dimen/rate_us_star_width"
            android:layout_height="@dimen/rate_us_star_width"
            android:src="@drawable/ic_star_rate_us"
            android:layout_marginStart="12dp"/>
    </LinearLayout>
</LinearLayout>
