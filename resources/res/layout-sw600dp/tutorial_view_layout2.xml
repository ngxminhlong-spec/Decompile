<?xml version="1.0" encoding="utf-8"?>
<com.duracodefactory.logiccircuitsimulatorpro.ui.TutorialView2 xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/welcome_screen_startup"
    android:background="@color/recents_bg"
    android:focusable="true"
    android:clickable="true"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="horizontal"
            android:background="@color/recents_bg"
            android:paddingTop="16dp"
            android:paddingBottom="16dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:elevation="1dp">
            <TextView
                android:textSize="18sp"
                android:layout_gravity="center_vertical"
                android:id="@+id/tutorial_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/help"
                android:fontFamily="sans-serif-medium"
                android:layout_marginStart="16dp"
                style="@style/BigDarkText"/>
        </LinearLayout>
        <FrameLayout
            android:layout_gravity="center_horizontal"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/new_tut_recycler"
                android:paddingTop="16dp"
                android:paddingBottom="24dp"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"/>
        </FrameLayout>
    </LinearLayout>
</com.duracodefactory.logiccircuitsimulatorpro.ui.TutorialView2>
